                              · have hcb : ((ltfB16 w1 t1).canon == allFalseB16) = false := by cases h : ((ltfB16 w1 t1).canon == allFalseB16) with | false => rfl | true => exact absurd (b16_beq_eq h) hc
                                simp only [isClassifiedCanon, hcb, ho0, ho1, ho2, ho3, ho4, ho5, ho6, ho7, ho8, ho9, ho10, ho11, ho12, ho13, Bool.or_false] at h1
                                cases h1

abbrev LNeuron := (Nat → Int) × Int

def evalLayer (k : Nat) (x : Nat → Int) : List LNeuron → List Bool
  | [] => []
  | (w, t) :: rest => decide (t ≤ dot k w x) :: evalLayer k x rest

def boolsToVec : List Bool → Nat → Int
  | [] => fun _ => 0
  | b :: bs => fun j => match j with | 0 => if b then 1 else 0 | j + 1 => boolsToVec bs j

def evalLayered (n : Nat) (x : Nat → Int) : List (List LNeuron) → LNeuron → Bool
  | [], (wOut, tOut) => decide (tOut ≤ dot n wOut x)
  | layer :: rest, out =>
      evalLayered layer.length (boolsToVec (evalLayer n x layer)) rest out

def sumNats : List Nat → Nat
  | [] => 0
  | x :: xs => x + sumNats xs

/-- 4-input parity cannot be computed by any strictly layered threshold network
    with at most 4 neurons total (gap B3). -/
theorem parity4_not_four_neurons :
    ¬ ∃ (hidden : List (List LNeuron)) (out : LNeuron),
      1 + sumNats (hidden.map List.length) ≤ 4 ∧
      ∀ x : Nat → Int, (∀ j, j < 4 → x j = 0 ∨ x j = 1) →
        evalLayered 4 x hidden out = parity4 x := by
  intro ⟨hidden, out, hsz, hev⟩
  cases hidden with
  | nil =>
      rcases out with ⟨wOut, tOut⟩
      apply parity4_not_three_ltf_determined
      refine ⟨wOut, fun _ => 0, fun _ => 0, tOut, 1, 1, fun a _ _ => a, fun x hx => ?_⟩
      exact hev x hx
  | cons layer rest =>
      simp only [List.map_cons, sumNats] at hsz
      have hlen : layer.length ≤ 3 := by omega
      match layer, hlen with
      | [], _ =>
          apply parity4_not_three_ltf_determined
          refine ⟨fun _ => 0, fun _ => 0, fun _ => 0, 1, 1, 1,
            fun _ _ _ => evalLayered 0 (boolsToVec []) rest out, fun x hx => ?_⟩
          exact hev x hx
      | [(w1, t1)], _ =>
          apply parity4_not_three_ltf_determined
          refine ⟨w1, fun _ => 0, fun _ => 0, t1, 1, 1,
            fun a _ _ => evalLayered 1 (boolsToVec [a]) rest out, fun x hx => ?_⟩
          exact hev x hx
      | [(w1, t1), (w2, t2)], _ =>
          apply parity4_not_three_ltf_determined
          refine ⟨w1, w2, fun _ => 0, t1, t2, 1,
            fun a b _ => evalLayered 2 (boolsToVec [a, b]) rest out, fun x hx => ?_⟩
          exact hev x hx
      | [(w1, t1), (w2, t2), (w3, t3)], _ =>
          apply parity4_not_three_ltf_determined
          refine ⟨w1, w2, w3, t1, t2, t3,
            fun a b c => evalLayered 3 (boolsToVec [a, b, c]) rest out, fun x hx => ?_⟩
          exact hev x hx

-- G5_BODY_END

end CerpBounds
