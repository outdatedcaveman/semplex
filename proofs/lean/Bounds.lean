inductive ElemOp where | neg0 | neg1 | neg2 | neg3 | sw01 | sw12 | sw23

def ElemOp.apply : ElemOp → B16 → B16
  | .neg0, f => f.neg0 | .neg1, f => f.neg1 | .neg2, f => f.neg2 | .neg3, f => f.neg3
  | .sw01, f => f.sw01 | .sw12, f => f.sw12 | .sw23, f => f.sw23

def ElemOp.ptMap : ElemOp → Pt4 → Pt4
  | .neg0, ⟨x0, x1, x2, x3⟩ => ⟨!x0, x1, x2, x3⟩
  | .neg1, ⟨x0, x1, x2, x3⟩ => ⟨x0, !x1, x2, x3⟩
  | .neg2, ⟨x0, x1, x2, x3⟩ => ⟨x0, x1, !x2, x3⟩
  | .neg3, ⟨x0, x1, x2, x3⟩ => ⟨x0, x1, x2, !x3⟩
  | .sw01, ⟨x0, x1, x2, x3⟩ => ⟨x1, x0, x2, x3⟩
  | .sw12, ⟨x0, x1, x2, x3⟩ => ⟨x0, x2, x1, x3⟩
  | .sw23, ⟨x0, x1, x2, x3⟩ => ⟨x0, x1, x3, x2⟩

def applyOps : List ElemOp → B16 → B16
  | [], f => f
  | op :: ops, f => applyOps ops (op.apply f)

private theorem applyOps_append (ops1 ops2 : List ElemOp) (f : B16) :
    applyOps (ops1 ++ ops2) f = applyOps ops2 (applyOps ops1 f) := by
  induction ops1 generalizing f with
  | nil => rfl
  | cons op rest ih => simp [applyOps, ih]

private theorem elemOp_involutive (op : ElemOp) (f : B16) : op.apply (op.apply f) = f := by
  cases op <;> cases f <;> rfl

private theorem applyOps_reverse (ops : List ElemOp) (f : B16) :
    applyOps ops.reverse (applyOps ops f) = f := by
  induction ops generalizing f with
  | nil => rfl
  | cons op rest ih =>
      simp [applyOps, List.reverse_cons, applyOps_append, ih, elemOp_involutive]

private theorem elemOp_not (op : ElemOp) (f : B16) : op.apply f.not = (op.apply f).not := by
  cases op <;> cases f <;> rfl

private theorem canon_not (f : B16) : f.not.canon = f.canon := by
  cases f; rename_i b0 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
  cases b0 <;> simp [B16.canon, B16.not]

private theorem canon_canon (f : B16) : f.canon.canon = f.canon := by
  cases f; rename_i b0 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
  cases b0 <;> simp [B16.canon]

private theorem canon_elemOp_canon (op : ElemOp) (f : B16) :
    (op.apply f.canon).canon = (op.apply f).canon := by
  rw [canon_eq_ite f]
  cases f.b0
  · rfl
  · simp [elemOp_not, canon_not]

private theorem applyOps_canon (ops : List ElemOp) (f : B16) :
    (applyOps ops f.canon).canon = (applyOps ops f).canon := by
  induction ops generalizing f with
  | nil => exact canon_canon f
  | cons op rest ih =>
      simp only [applyOps]
      rw [← ih (op.apply f.canon), canon_elemOp_canon, ih (op.apply f)]

private theorem neg1_eq (f : B16) : f.neg1 = f.sw01.neg0.sw01 := by cases f <;> rfl
private theorem neg2_eq (f : B16) : f.neg2 = f.sw12.neg1.sw12 := by cases f <;> rfl
private theorem neg3_eq (f : B16) : f.neg3 = f.sw23.neg2.sw23 := by cases f <;> rfl
private theorem neg_allFalse (n : Neg16) : allFalseB16.applyNeg n = allFalseB16 := by cases n <;> rfl
private theorem perm_allFalse (p : Perm24) : allFalseB16.permBy p = allFalseB16 := by cases p <;> rfl
private theorem elemOp_allFalse (op : ElemOp) : op.apply allFalseB16 = allFalseB16 := by cases op <;> rfl
private theorem elemOp_allTrue (op : ElemOp) : op.apply allFalseB16.not = allFalseB16.not := by cases op <;> rfl

private theorem applyB4Canon_allFalse (c : B4Code) : allFalseB16.applyB4Canon c = allFalseB16 := by
  simp only [B16.applyB4Canon, B16.applyB4, neg_allFalse, perm_allFalse]; rfl

private theorem isLtf_elemOp (op : ElemOp) {g : B16} (hg : IsLtfB16 g) : IsLtfB16 (op.apply g) := by
  rcases hg with ⟨w, t, rfl⟩
  cases op
  · exact ⟨_, _, neg0_ltf w t⟩
  · exact ⟨_, _, neg1_ltf w t⟩
  · exact ⟨_, _, neg2_ltf w t⟩
  · exact ⟨_, _, neg3_ltf w t⟩
  · exact ⟨_, _, sw01_ltf w t⟩
  · exact ⟨_, _, sw12_ltf w t⟩
  · exact ⟨_, _, sw23_ltf w t⟩

private theorem atPt_elemOp (op : ElemOp) (f : B16) (p : Pt4) :
    (op.apply f).atPt p = f.atPt (op.ptMap p) := by
  cases op <;> cases p <;> rename_i x0 x1 x2 x3 <;>
    cases x0 <;> cases x1 <;> cases x2 <;> cases x3 <;> rfl

private theorem ptMap_invol (op : ElemOp) (p : Pt4) : op.ptMap (op.ptMap p) = p := by
  cases op <;> cases p <;> rename_i x0 x1 x2 x3 <;>
    cases x0 <;> cases x1 <;> cases x2 <;> cases x3 <;> rfl

private theorem p4B16_elemOp_neg (op : ElemOp) (p : Pt4) :
    p4B16.atPt (op.ptMap p) =
      match op with
      | .neg0 | .neg1 | .neg2 | .neg3 => !(p4B16.atPt p)
      | .sw01 | .sw12 | .sw23 => p4B16.atPt p := by
  cases op <;> cases p <;> rename_i x0 x1 x2 x3 <;>
    cases x0 <;> cases x1 <;> cases x2 <;> cases x3 <;> rfl

private theorem det_elemOp (op : ElemOp) {g1 g2 g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hdet : ∀ p : Pt4, Ψ (g1.atPt p) (g2.atPt p) (g3.atPt p) = p4B16.atPt p) :
    ∃ Ψ' : Bool → Bool → Bool → Bool,
      ∀ p : Pt4, Ψ' ((op.apply g1).atPt p) ((op.apply g2).atPt p) ((op.apply g3).atPt p) = p4B16.atPt p := by
  have hbase : ∀ p : Pt4,
      Ψ ((op.apply g1).atPt p) ((op.apply g2).atPt p) ((op.apply g3).atPt p) = p4B16.atPt (op.ptMap p) := by
    intro p
    rw [atPt_elemOp, atPt_elemOp, atPt_elemOp]
    exact hdet (op.ptMap p)
  cases op
  · refine ⟨fun a b c => !(Ψ a b c), fun p => ?_⟩; dsimp only; rw [hbase p, p4B16_elemOp_neg .neg0]; simp
  · refine ⟨fun a b c => !(Ψ a b c), fun p => ?_⟩; dsimp only; rw [hbase p, p4B16_elemOp_neg .neg1]; simp
  · refine ⟨fun a b c => !(Ψ a b c), fun p => ?_⟩; dsimp only; rw [hbase p, p4B16_elemOp_neg .neg2]; simp
  · refine ⟨fun a b c => !(Ψ a b c), fun p => ?_⟩; dsimp only; rw [hbase p, p4B16_elemOp_neg .neg3]; simp
  · refine ⟨Ψ, fun p => ?_⟩; rw [hbase p, p4B16_elemOp_neg .sw01]
  · refine ⟨Ψ, fun p => ?_⟩; rw [hbase p, p4B16_elemOp_neg .sw12]
  · refine ⟨Ψ, fun p => ?_⟩; rw [hbase p, p4B16_elemOp_neg .sw23]

private theorem det_applyOps :
    ∀ (ops : List ElemOp) {g1 g2 g3 : B16} {Ψ : Bool → Bool → Bool → Bool},
      IsLtfB16 g3 →
      (∀ p : Pt4, Ψ (g1.atPt p) (g2.atPt p) (g3.atPt p) = p4B16.atPt p) →
      ∃ (g3' : B16) (Ψ' : Bool → Bool → Bool → Bool), IsLtfB16 g3' ∧
        ∀ p : Pt4, Ψ' ((applyOps ops g1).atPt p) ((applyOps ops g2).atPt p) (g3'.atPt p) = p4B16.atPt p
  | [], g1, g2, g3, Ψ, hg3, hdet => ⟨g3, Ψ, hg3, hdet⟩
  | op :: rest, g1, g2, g3, Ψ, hg3, hdet => by
      rcases det_elemOp op hdet with ⟨Ψ1, h1⟩
      exact det_applyOps rest (isLtf_elemOp op hg3) h1

def Neg16.toOps : Neg16 → List ElemOp
  | .n0 => []
  | .n1 => [.neg0]
  | .n2 => [.neg1]
  | .n3 => [.neg0, .neg1]
  | .n4 => [.neg2]
  | .n5 => [.neg0, .neg2]
  | .n6 => [.neg1, .neg2]
  | .n7 => [.neg0, .neg1, .neg2]
  | .n8 => [.neg3]
  | .n9 => [.neg0, .neg3]
  | .n10 => [.neg1, .neg3]
  | .n11 => [.neg0, .neg1, .neg3]
  | .n12 => [.neg2, .neg3]
  | .n13 => [.neg0, .neg2, .neg3]
  | .n14 => [.neg1, .neg2, .neg3]
  | .n15 => [.neg0, .neg1, .neg2, .neg3]
def Perm24.toOps : Perm24 → List ElemOp
  | .p0 => []
  | .p1 => [.sw23]
  | .p2 => [.sw12]
  | .p3 => [.sw23, .sw12]
  | .p4 => [.sw12, .sw23]
  | .p5 => [.sw12, .sw23, .sw12]
  | .p6 => [.sw01]
  | .p7 => [.sw01, .sw23]
  | .p8 => [.sw12, .sw01]
  | .p9 => [.sw23, .sw12, .sw01]
  | .p10 => [.sw12, .sw01, .sw23]
  | .p11 => [.sw12, .sw23, .sw12, .sw01]
  | .p12 => [.sw01, .sw12]
  | .p13 => [.sw01, .sw23, .sw12]
  | .p14 => [.sw01, .sw12, .sw01]
  | .p15 => [.sw01, .sw23, .sw12, .sw01]
  | .p16 => [.sw12, .sw01, .sw23, .sw12]
  | .p17 => [.sw12, .sw01, .sw23, .sw12, .sw01]
  | .p18 => [.sw01, .sw12, .sw23]
  | .p19 => [.sw01, .sw12, .sw23, .sw12]
  | .p20 => [.sw01, .sw12, .sw01, .sw23]
  | .p21 => [.sw01, .sw12, .sw23, .sw12, .sw01]
  | .p22 => [.sw01, .sw12, .sw01, .sw23, .sw12]
  | .p23 => [.sw01, .sw12, .sw01, .sw23, .sw12, .sw01]
def B4Code.toOps (c : B4Code) : List ElemOp := c.n.toOps ++ c.p.toOps
private theorem applyNeg_eq_applyOps (n : Neg16) (f : B16) : f.applyNeg n = applyOps n.toOps f := by cases n <;> cases f <;> rfl
private theorem permBy_eq_applyOps (p : Perm24) (f : B16) : f.permBy p = applyOps p.toOps f := by cases p <;> cases f <;> rfl

private theorem applyB4_eq_applyOps (c : B4Code) (f : B16) :
    f.applyB4 c = applyOps c.toOps f := by
  unfold B16.applyB4 B4Code.toOps
  rw [applyOps_append, applyNeg_eq_applyOps, permBy_eq_applyOps]

private theorem det_canon_12 {g1 g2 g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hdet : ∀ p : Pt4, Ψ (g1.atPt p) (g2.atPt p) (g3.atPt p) = p4B16.atPt p) :
    ∃ Ψ' : Bool → Bool → Bool → Bool,
      ∀ p : Pt4, Ψ' (g1.canon.atPt p) (g2.canon.atPt p) (g3.atPt p) = p4B16.atPt p := by
  rw [canon_eq_ite g1, canon_eq_ite g2]
  cases hb1 : g1.b0 <;> cases hb2 : g2.b0 <;> simp only [Bool.false_eq_true, ↓reduceIte]
  · exact ⟨Ψ, hdet⟩
  · refine ⟨fun a b c => Ψ a (!b) c, fun p => ?_⟩
    dsimp only; rw [atPt_not, Bool.not_not]; exact hdet p
  · refine ⟨fun a b c => Ψ (!a) b c, fun p => ?_⟩
    dsimp only; rw [atPt_not, Bool.not_not]; exact hdet p
  · refine ⟨fun a b c => Ψ (!a) (!b) c, fun p => ?_⟩
    dsimp only; rw [atPt_not, atPt_not, Bool.not_not, Bool.not_not]; exact hdet p

private theorem det_applyB4Canon (c : B4Code) {g1 g2 g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hg3 : IsLtfB16 g3)
    (hdet : ∀ p : Pt4, Ψ (g1.atPt p) (g2.atPt p) (g3.atPt p) = p4B16.atPt p) :
    ∃ (g3' : B16) (Ψ' : Bool → Bool → Bool → Bool), IsLtfB16 g3' ∧
      ∀ p : Pt4, Ψ' ((g1.applyB4Canon c).atPt p) ((g2.applyB4Canon c).atPt p) (g3'.atPt p) = p4B16.atPt p := by
  rcases det_applyOps c.toOps hg3 hdet with ⟨g3', Ψ1, hg3', h1⟩
  rw [← applyB4_eq_applyOps, ← applyB4_eq_applyOps] at h1
  rcases det_canon_12 h1 with ⟨Ψ2, h2⟩
  exact ⟨g3', Ψ2, hg3', h2⟩

def isNonneg4 (w : Nat → Int) : Prop := 0 ≤ w 0 ∧ 0 ≤ w 1 ∧ 0 ≤ w 2 ∧ 0 ≤ w 3
def isMonotone4 (w : Nat → Int) : Prop := 0 ≤ w 0 ∧ w 0 ≤ w 1 ∧ w 1 ≤ w 2 ∧ w 2 ≤ w 3

private theorem step_nonneg0 (w : Nat → Int) (t : Int) :
    ∃ ops w' t', 0 ≤ w' 0 ∧ (w' 1 = w 1 ∧ w' 2 = w 2 ∧ w' 3 = w 3) ∧
      applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  by_cases h : 0 ≤ w 0
  · exact ⟨[], w, t, h, ⟨rfl, rfl, rfl⟩, rfl⟩
  · refine ⟨[.neg0], pt4 (-w 0) (w 1) (w 2) (w 3), t - w 0, ?_, ?_, ?_⟩
    · simp [pt4]; omega
    · simp [pt4]
    · simp [applyOps, ElemOp.apply, neg0_ltf]

private theorem step_nonneg1 (w : Nat → Int) (t : Int) (h0 : 0 ≤ w 0) :
    ∃ ops w' t', (0 ≤ w' 0 ∧ 0 ≤ w' 1) ∧ (w' 2 = w 2 ∧ w' 3 = w 3) ∧
      applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  by_cases h : 0 ≤ w 1
  · exact ⟨[], w, t, ⟨h0, h⟩, ⟨rfl, rfl⟩, rfl⟩
  · refine ⟨[.neg1], pt4 (w 0) (-w 1) (w 2) (w 3), t - w 1, ?_, ?_, ?_⟩
    · simp [pt4]; omega
    · simp [pt4]
    · simp [applyOps, ElemOp.apply, neg1_ltf]

private theorem step_nonneg2 (w : Nat → Int) (t : Int) (h0 : 0 ≤ w 0) (h1 : 0 ≤ w 1) :
    ∃ ops w' t', (0 ≤ w' 0 ∧ 0 ≤ w' 1 ∧ 0 ≤ w' 2) ∧ w' 3 = w 3 ∧
      applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  by_cases h : 0 ≤ w 2
  · exact ⟨[], w, t, ⟨h0, h1, h⟩, rfl, rfl⟩
  · refine ⟨[.neg2], pt4 (w 0) (w 1) (-w 2) (w 3), t - w 2, ?_, ?_, ?_⟩
    · simp [pt4]; omega
    · simp [pt4]
    · simp [applyOps, ElemOp.apply, neg2_ltf]

private theorem step_nonneg3 (w : Nat → Int) (t : Int) (h0 : 0 ≤ w 0) (h1 : 0 ≤ w 1) (h2 : 0 ≤ w 2) :
    ∃ ops w' t', isNonneg4 w' ∧ applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  by_cases h : 0 ≤ w 3
  · exact ⟨[], w, t, ⟨h0, h1, h2, h⟩, rfl⟩
  · refine ⟨[.neg3], pt4 (w 0) (w 1) (w 2) (-w 3), t - w 3, ?_, ?_⟩
    · simp [isNonneg4, pt4]; omega
    · simp [applyOps, ElemOp.apply, neg3_ltf]

private theorem make_nonneg4 (w : Nat → Int) (t : Int) :
    ∃ ops w' t', isNonneg4 w' ∧ applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  rcases step_nonneg0 w t with ⟨o0, w0, t0, h0, _, e0⟩
  rcases step_nonneg1 w0 t0 h0 with ⟨o1, w1, t1, ⟨h01, h11⟩, _, e1⟩
  rcases step_nonneg2 w1 t1 h01 h11 with ⟨o2, w2, t2, ⟨h02, h12, h22⟩, _, e2⟩
  rcases step_nonneg3 w2 t2 h02 h12 h22 with ⟨o3, w3, t3, hn3, e3⟩
  exact ⟨o0 ++ o1 ++ o2 ++ o3, w3, t3, hn3, by simp [applyOps_append, e0, e1, e2, e3]⟩

private theorem step_sw01_of (w : Nat → Int) (t : Int) :
    ∃ ops w' t', (w' 0 ≤ w' 1 ∧ ((w' 0 = w 0 ∧ w' 1 = w 1) ∨ (w' 0 = w 1 ∧ w' 1 = w 0)) ∧ w' 2 = w 2 ∧ w' 3 = w 3) ∧
      applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  by_cases h : w 0 ≤ w 1
  · exact ⟨[], w, t, ⟨h, Or.inl ⟨rfl, rfl⟩, rfl, rfl⟩, rfl⟩
  · refine ⟨[.sw01], pt4 (w 1) (w 0) (w 2) (w 3), t, ⟨?_, Or.inr ?_, ?_, ?_⟩, ?_⟩
    · simp [pt4]; omega
    · simp [pt4]
    · rfl
    · rfl
    · simp [applyOps, ElemOp.apply, sw01_ltf]

private theorem step_sw12_of (w : Nat → Int) (t : Int) :
    ∃ ops w' t', (w' 1 ≤ w' 2 ∧ w' 0 = w 0 ∧ ((w' 1 = w 1 ∧ w' 2 = w 2) ∨ (w' 1 = w 2 ∧ w' 2 = w 1)) ∧ w' 3 = w 3) ∧
      applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  by_cases h : w 1 ≤ w 2
  · exact ⟨[], w, t, ⟨h, rfl, Or.inl ⟨rfl, rfl⟩, rfl⟩, rfl⟩
  · refine ⟨[.sw12], pt4 (w 0) (w 2) (w 1) (w 3), t, ⟨?_, rfl, Or.inr ?_, rfl⟩, ?_⟩
    · simp [pt4]; omega
    · simp [pt4]
    · simp [applyOps, ElemOp.apply, sw12_ltf]

private theorem step_sw23_of (w : Nat → Int) (t : Int) :
    ∃ ops w' t', (w' 2 ≤ w' 3 ∧ w' 0 = w 0 ∧ w' 1 = w 1 ∧ ((w' 2 = w 2 ∧ w' 3 = w 3) ∨ (w' 2 = w 3 ∧ w' 3 = w 2))) ∧
      applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  by_cases h : w 2 ≤ w 3
  · exact ⟨[], w, t, ⟨h, rfl, rfl, Or.inl ⟨rfl, rfl⟩⟩, rfl⟩
  · refine ⟨[.sw23], pt4 (w 0) (w 1) (w 3) (w 2), t, ⟨?_, rfl, rfl, Or.inr ?_⟩, ?_⟩
    · simp [pt4]; omega
    · simp [pt4]
    · simp [applyOps, ElemOp.apply, sw23_ltf]

private theorem pass_max3 (w : Nat → Int) (t : Int) (hn : isNonneg4 w) :
    ∃ ops w' t', (isNonneg4 w' ∧ w' 0 ≤ w' 3 ∧ w' 1 ≤ w' 3 ∧ w' 2 ≤ w' 3) ∧
      applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  rcases step_sw01_of w t with ⟨o1, w1, t1, ⟨_, h01eq, h2, h3⟩, e1⟩
  have hn1 : isNonneg4 w1 := by rcases hn with ⟨a,b,c,d⟩; rcases h01eq with ⟨r0,r1⟩ | ⟨r0,r1⟩ <;> simp [isNonneg4, r0, r1, h2, h3, a, b, c, d]
  rcases step_sw12_of w1 t1 with ⟨o2, w2, t2, ⟨_, h0, h12eq, h3'⟩, e2⟩
  have hn2 : isNonneg4 w2 := by rcases hn1 with ⟨a,b,c,d⟩; rcases h12eq with ⟨r1,r2⟩ | ⟨r1,r2⟩ <;> simp [isNonneg4, h0, r1, r2, h3', a, b, c, d]
  have h02 : w2 0 ≤ w2 2 ∧ w2 1 ≤ w2 2 := by
    rcases h12eq with ⟨r1, r2⟩ | ⟨r1, r2⟩ <;> (constructor <;> omega)
  rcases step_sw23_of w2 t2 with ⟨o3, w3, t3, ⟨h23, h0', h1', h23eq⟩, e3⟩
  have hn3 : isNonneg4 w3 := by rcases hn2 with ⟨a,b,c,d⟩; rcases h23eq with ⟨r2,r3⟩ | ⟨r2,r3⟩ <;> simp [isNonneg4, h0', h1', r2, r3, a, b, c, d]
  have hmax : w3 0 ≤ w3 3 ∧ w3 1 ≤ w3 3 ∧ w3 2 ≤ w3 3 := by
    rcases h23eq with ⟨r2, r3⟩ | ⟨r2, r3⟩ <;> omega
  exact ⟨o1 ++ o2 ++ o3, w3, t3, ⟨hn3, hmax⟩, by simp [applyOps_append, e1, e2, e3]⟩

private theorem pass_max2 (w : Nat → Int) (t : Int)
    (h : isNonneg4 w ∧ w 0 ≤ w 3 ∧ w 1 ≤ w 3 ∧ w 2 ≤ w 3) :
    ∃ ops w' t', (isNonneg4 w' ∧ w' 0 ≤ w' 2 ∧ w' 1 ≤ w' 2 ∧ w' 2 ≤ w' 3) ∧
      applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  rcases h with ⟨⟨a,b,c,d⟩, ha3, hb3, hc3⟩
  rcases step_sw01_of w t with ⟨o1, w1, t1, ⟨_, h01eq, h2, h3⟩, e1⟩
  have w1_ok : isNonneg4 w1 ∧ w1 0 ≤ w1 3 ∧ w1 1 ≤ w1 3 ∧ w1 2 ≤ w1 3 := by
    rcases h01eq with ⟨r0, r1⟩ | ⟨r0, r1⟩ <;> exact ⟨⟨by omega, by omega, by omega, by omega⟩, by omega, by omega, by omega⟩
  rcases w1_ok with ⟨⟨a1,b1,c1,d1⟩, h03, h13, h23⟩
  rcases step_sw12_of w1 t1 with ⟨o2, w2, t2, ⟨h12, h0, h12eq, h3'⟩, e2⟩
  refine ⟨o1 ++ o2, w2, t2, ?_, by simp [applyOps_append, e1, e2]⟩
  rcases h12eq with ⟨r1, r2⟩ | ⟨r1, r2⟩ <;> exact ⟨⟨by omega, by omega, by omega, by omega⟩, by omega, by omega, by omega⟩

theorem regularize_ltf (w : Nat → Int) (t : Int) :
    ∃ (ops : List ElemOp) (w' : Nat → Int) (t' : Int),
      isMonotone4 w' ∧ applyOps ops (ltfB16 w t) = ltfB16 w' t' := by
  rcases make_nonneg4 w t with ⟨o0, w0, t0, hn0, e0⟩
  rcases pass_max3 w0 t0 hn0 with ⟨o1, w1, t1, hm1, e1⟩
  rcases pass_max2 w1 t1 hm1 with ⟨o2, w2, t2, ⟨⟨a,b,c,d⟩, h02, h12, h23⟩, e2⟩
  rcases step_sw01_of w2 t2 with ⟨o3, w3, t3, ⟨h01, h01eq, h2, h3⟩, e3⟩
  refine ⟨o0 ++ o1 ++ o2 ++ o3, w3, t3, ?_, by simp [applyOps_append, e0, e1, e2, e3]⟩
  rcases h01eq with ⟨r0, r1⟩ | ⟨r0, r1⟩ <;> exact ⟨by omega, by omega, by omega, by omega⟩

private theorem ltf4_mono {w : Nat → Int} {t : Int} {p q : Pt4}
    (hle : dot 4 w (pt4ToFn p) ≤ dot 4 w (pt4ToFn q)) :
    (!(ltf4 w t p) || ltf4 w t q) = true := by
  simp only [ltf4]
  by_cases hp : t ≤ dot 4 w (pt4ToFn p)
  · have hq : t ≤ dot 4 w (pt4ToFn q) := Int.le_trans hp hle
    simp [hp, hq]
  · simp [hp]

theorem monotone_isRegular {w : Nat → Int} (t : Int) (hm : isMonotone4 w) :
    isRegularB16 (ltfB16 w t) = true := by
  rcases hm with ⟨h0, h01, h12, h23⟩
  have e : ∀ a b, dot 4 w (pt4ToFn a) ≤ dot 4 w (pt4ToFn b) → (!(ltf4 w t a) || ltf4 w t b) = true :=
    fun _ _ h => ltf4_mono h
  simp only [isRegularB16, ltfB16, Bool.and_eq_true]
  repeat' constructor
  all_goals exact e _ _ (by simp only [dot, pt4ToFn, pt4, g5_b2i]; omega)

private theorem or_imp_self {a b c : Bool} (h1 : (!a || c) = true) (h2 : (!b || c) = true) :
    (!(a || b) || c) = true := by
  cases a <;> cases b <;> cases c <;> simp_all

theorem isRegular_classified (g : B16) (hr : isRegularB16 g = true) :
    isClassifiedCanon g.canon = true := by
  rcases g with ⟨b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15⟩
  simp only [isRegularB16, Bool.and_eq_true] at hr
  rcases hr with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨h01,h23⟩,h45⟩,h67⟩,h89⟩,h1011⟩,h1213⟩,h1415⟩,h12⟩,h56⟩,h910⟩,h1314⟩,h24⟩,h35⟩,h1012⟩,h1113⟩,h48⟩,h59⟩,h610⟩,h711⟩
  have s0 : (!false || b0) = true := by simp
  have s5 : (!(b3 || b4) || b5) = true := or_imp_self h35 h45
  have s9 : (!(b5 || b8) || b9) = true := or_imp_self h59 h89
  have s10 : (!(b6 || b9) || b10) = true := or_imp_self h610 h910
  have s11 : (!(b7 || b10) || b11) = true := or_imp_self h711 h1011
  have s13 : (!(b11 || b12) || b13) = true := or_imp_self h1113 h1213
  have r0 := regOk_sound s0 t_reg_exhaust
  have r1 := regOk_sound h01 r0
  have r2 := regOk_sound h12 r1
  have r3 := regOk_sound h23 r2
  have r4 := regOk_sound h24 r3
  have r5 := regOk_sound s5 r4
  have r6 := regOk_sound h56 r5
  have r7 := regOk_sound h67 r6
  have r8 := regOk_sound h48 r7
  have r9 := regOk_sound s9 r8
  have r10 := regOk_sound s10 r9
  have r11 := regOk_sound s11 r10
  have r12 := regOk_sound h1012 r11
  have r13 := regOk_sound s13 r12
  have r14 := regOk_sound h1314 r13
  have r15 := regOk_sound (k := fun b15 => isClassifiedCanon (⟨b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15⟩ : B16).canon) h1415 r14
  exact r15

private theorem trie15_step_all {α : Type} {p : α → Bool} {t : Trie15 α}
    (ha : t.all p = true) (b : Bool) : (Trie15.step b t).all p = true := by
  cases t with
  | empty => simp [Trie15.step, Trie15.all]
  | leaf v => simp [Trie15.step, Trie15.all]
  | branch l r =>
      simp only [Trie15.all, Bool.and_eq_true] at ha
      cases b <;> simp [Trie15.step, ha.1, ha.2]

private theorem trie15_lookup_all {α : Type} {p : α → Bool} {t : Trie15 α} {f : B16} {v : α}
    (ha : t.all p = true) (hl : t.lookup f = some v) : p v = true := by
  rcases f with ⟨b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15⟩
  simp only [Trie15.lookup] at hl
  cases b0
  · simp only [Bool.false_eq_true, ↓reduceIte] at hl
    have h1 := trie15_step_all ha b1
    have h2 := trie15_step_all h1 b2
    have h3 := trie15_step_all h2 b3
    have h4 := trie15_step_all h3 b4
    have h5 := trie15_step_all h4 b5
    have h6 := trie15_step_all h5 b6
    have h7 := trie15_step_all h6 b7
    have h8 := trie15_step_all h7 b8
    have h9 := trie15_step_all h8 b9
    have h10 := trie15_step_all h9 b10
    have h11 := trie15_step_all h10 b11
    have h12 := trie15_step_all h11 b12
    have h13 := trie15_step_all h12 b13
    have h14 := trie15_step_all h13 b14
    have h15 := trie15_step_all h14 b15
    cases hs : Trie15.step b15 (Trie15.step b14 (Trie15.step b13 (Trie15.step b12
      (Trie15.step b11 (Trie15.step b10 (Trie15.step b9 (Trie15.step b8
      (Trie15.step b7 (Trie15.step b6 (Trie15.step b5 (Trie15.step b4
      (Trie15.step b3 (Trie15.step b2 (Trie15.step b1 t)))))))))))))) with
    | empty => simp [hs] at hl
    | leaf w => simp only [hs] at hl; cases hl; rw [hs] at h15; exact h15
    | branch _ _ => simp [hs] at hl
  · simp at hl

private theorem trie15_step_zipAll {α β : Type} {p : α → β → Bool} {t1 : Trie15 α} {t2 : Trie15 β}
    (hz : Trie15.zipAll p t1 t2 = true) (b : Bool) :
    Trie15.zipAll p (Trie15.step b t1) (Trie15.step b t2) = true := by
  match t1, t2 with
  | .empty, .empty => simp [Trie15.step, Trie15.zipAll]
  | .leaf _, .leaf _ => simp [Trie15.step, Trie15.zipAll]
  | .branch _ _, .branch _ _ =>
      simp only [Trie15.zipAll, Bool.and_eq_true] at hz
      cases b <;> simp [Trie15.step, hz.1, hz.2]
  | .empty, .leaf _ | .empty, .branch _ _ | .leaf _, .empty | .leaf _, .branch _ _
  | .branch _ _, .empty | .branch _ _, .leaf _ =>
      simp [Trie15.zipAll] at hz

private theorem trie15_lookup_zipAll {α β : Type} {p : α → β → Bool}
    {t1 : Trie15 α} {t2 : Trie15 β} {f : B16} {a : α}
    (hz : Trie15.zipAll p t1 t2 = true) (hl : t1.lookup f = some a) :
    ∃ b, t2.lookup f = some b ∧ p a b = true := by
  rcases f with ⟨b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15⟩
  simp only [Trie15.lookup] at hl ⊢
  cases b0
  · simp only [Bool.false_eq_true, ↓reduceIte] at hl ⊢
    have h15 := trie15_step_zipAll (trie15_step_zipAll (trie15_step_zipAll (trie15_step_zipAll
      (trie15_step_zipAll (trie15_step_zipAll (trie15_step_zipAll (trie15_step_zipAll
      (trie15_step_zipAll (trie15_step_zipAll (trie15_step_zipAll (trie15_step_zipAll
      (trie15_step_zipAll (trie15_step_zipAll (trie15_step_zipAll hz b1) b2) b3) b4) b5) b6) b7)
      b8) b9) b10) b11) b12) b13) b14) b15
    generalize ht1 : Trie15.step b15 (Trie15.step b14 (Trie15.step b13 (Trie15.step b12
      (Trie15.step b11 (Trie15.step b10 (Trie15.step b9 (Trie15.step b8
      (Trie15.step b7 (Trie15.step b6 (Trie15.step b5 (Trie15.step b4
      (Trie15.step b3 (Trie15.step b2 (Trie15.step b1 t1)))))))))))))) = s1 at hl h15
    generalize ht2 : Trie15.step b15 (Trie15.step b14 (Trie15.step b13 (Trie15.step b12
      (Trie15.step b11 (Trie15.step b10 (Trie15.step b9 (Trie15.step b8
      (Trie15.step b7 (Trie15.step b6 (Trie15.step b5 (Trie15.step b4
      (Trie15.step b3 (Trie15.step b2 (Trie15.step b1 t2)))))))))))))) = s2 at h15 ⊢
    cases s1 with
    | empty => simp at hl
    | branch _ _ => simp at hl
    | leaf x =>
        cases hl
        cases s2 with
        | empty => simp [Trie15.zipAll] at h15
        | branch _ _ => simp [Trie15.zipAll] at h15
        | leaf y =>
            simp only [Trie15.zipAll] at h15
            exact ⟨y, rfl, h15⟩
  · simp at hl

private theorem itrie_step_all {α : Type} {p : α → Bool} {t : ITrie α}
    (ha : t.all p = true) (b : Bool) : (ITrie.step b t).all p = true := by
  cases t with
  | empty => simp [ITrie.step, ITrie.all]
  | leaf v => simp [ITrie.step, ITrie.all]
  | branch l r =>
      simp only [ITrie.all, Bool.and_eq_true] at ha
      cases b <;> simp [ITrie.step, ha.1, ha.2]

private theorem itrie_get7?_all {α : Type} {p : α → Bool} {t : ITrie α} {k : Bits7} {v : α}
    (ha : t.all p = true) (hl : t.get7? k = some v) : p v = true := by
  simp only [ITrie.get7?] at hl
  have h1 := itrie_step_all ha k.k6
  have h2 := itrie_step_all h1 k.k5
  have h3 := itrie_step_all h2 k.k4
  have h4 := itrie_step_all h3 k.k3
  have h5 := itrie_step_all h4 k.k2
  have h6 := itrie_step_all h5 k.k1
  have h7 := itrie_step_all h6 k.k0
  cases hs : ITrie.step k.k0 (ITrie.step k.k1 (ITrie.step k.k2 (ITrie.step k.k3
    (ITrie.step k.k4 (ITrie.step k.k5 (ITrie.step k.k6 t)))))) with
  | empty => simp [hs] at hl
  | leaf w => simp only [hs] at hl; cases hl; rw [hs] at h7; exact h7
  | branch _ _ => simp [hs] at hl

private theorem itrie_get10?_all {α : Type} {p : α → Bool} {t : ITrie α} {k : Bits10} {v : α}
    (ha : t.all p = true) (hl : t.get10? k = some v) : p v = true := by
  simp only [ITrie.get10?] at hl
  have h1 := itrie_step_all ha k.k9
  have h2 := itrie_step_all h1 k.k8
  have h3 := itrie_step_all h2 k.k7
  have h4 := itrie_step_all h3 k.k6
  have h5 := itrie_step_all h4 k.k5
  have h6 := itrie_step_all h5 k.k4
  have h7 := itrie_step_all h6 k.k3
  have h8 := itrie_step_all h7 k.k2
  have h9 := itrie_step_all h8 k.k1
  have h10 := itrie_step_all h9 k.k0
  cases hs : ITrie.step k.k0 (ITrie.step k.k1 (ITrie.step k.k2 (ITrie.step k.k3
    (ITrie.step k.k4 (ITrie.step k.k5 (ITrie.step k.k6 (ITrie.step k.k7
    (ITrie.step k.k8 (ITrie.step k.k9 t))))))))) with
  | empty => simp [hs] at hl
  | leaf w => simp only [hs] at hl; cases hl; rw [hs] at h10; exact h10
  | branch _ _ => simp [hs] at hl

private theorem itrie_step_zipAll {α β : Type} {p : α → β → Bool} {t1 : ITrie α} {t2 : ITrie β}
    (hz : ITrie.zipAll p t1 t2 = true) (b : Bool) :
    ITrie.zipAll p (ITrie.step b t1) (ITrie.step b t2) = true := by
  match t1, t2 with
  | .empty, .empty => simp [ITrie.step, ITrie.zipAll]
  | .leaf _, .leaf _ => simp [ITrie.step, ITrie.zipAll]
  | .branch _ _, .branch _ _ =>
      simp only [ITrie.zipAll, Bool.and_eq_true] at hz
      cases b <;> simp [ITrie.step, hz.1, hz.2]
  | .empty, .leaf _ | .empty, .branch _ _ | .leaf _, .empty | .leaf _, .branch _ _
  | .branch _ _, .empty | .branch _ _, .leaf _ =>
      simp [ITrie.zipAll] at hz

private theorem itrie_get10?_zipAll_right {α β : Type} {p : α → β → Bool}
    {t1 : ITrie α} {t2 : ITrie β} {k : Bits10} {b : β}
    (hz : ITrie.zipAll p t1 t2 = true) (hl : t2.get10? k = some b) :
    ∃ a, t1.get10? k = some a ∧ p a b = true := by
  simp only [ITrie.get10?] at hl ⊢
  have h10 := itrie_step_zipAll (itrie_step_zipAll (itrie_step_zipAll (itrie_step_zipAll
    (itrie_step_zipAll (itrie_step_zipAll (itrie_step_zipAll (itrie_step_zipAll
    (itrie_step_zipAll (itrie_step_zipAll hz k.k9) k.k8) k.k7) k.k6) k.k5) k.k4) k.k3)
    k.k2) k.k1) k.k0
  generalize hs1 : ITrie.step k.k0 (ITrie.step k.k1 (ITrie.step k.k2 (ITrie.step k.k3
    (ITrie.step k.k4 (ITrie.step k.k5 (ITrie.step k.k6 (ITrie.step k.k7
    (ITrie.step k.k8 (ITrie.step k.k9 t1))))))))) = s1 at h10 ⊢
  generalize hs2 : ITrie.step k.k0 (ITrie.step k.k1 (ITrie.step k.k2 (ITrie.step k.k3
    (ITrie.step k.k4 (ITrie.step k.k5 (ITrie.step k.k6 (ITrie.step k.k7
    (ITrie.step k.k8 (ITrie.step k.k9 t2))))))))) = s2 at hl h10
  cases s2 with
  | empty => simp at hl
  | branch _ _ => simp at hl
  | leaf y =>
      cases hl
      cases s1 with
      | empty => simp [ITrie.zipAll] at h10
      | branch _ _ => simp [ITrie.zipAll] at h10
      | leaf x =>
          simp only [ITrie.zipAll] at h10
          exact ⟨x, rfl, h10⟩

private theorem b16_beq_eq {a b : B16} (h : (a == b) = true) : a = b := by
  simp only [beq_iff_eq] at h
  exact h

private theorem inOrbitTrie_b0 {t : Trie15 (B16 × B4Code)} {f : B16}
    (hf : inOrbitTrie t f = true) : f.b0 = false := by
  rcases f with ⟨b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15⟩
  cases b0
  · rfl
  · simp [inOrbitTrie, Trie15.lookup] at hf

private theorem inOrbitTrie_canon {t : Trie15 (B16 × B4Code)} {f : B16}
    (hf : inOrbitTrie t f = true) : f.canon = f := by
  have hb := inOrbitTrie_b0 hf
  rw [canon_eq_ite, hb]; rfl

private theorem inOrbitTrie_spec {t : Trie15 (B16 × B4Code)} {f : B16}
    (hf : inOrbitTrie t f = true) : ∃ σ, t.lookup f = some (f, σ) := by
  unfold inOrbitTrie at hf
  cases hl : t.lookup f with
  | none => rw [hl] at hf; simp at hf
  | some v =>
      rcases v with ⟨g, σ⟩
      rw [hl] at hf
      have hgf : g = f := b16_beq_eq hf
      subst hgf
      exact ⟨σ, rfl⟩

private def OrbitClosed (t : Trie15 (B16 × B4Code)) (rep : B16) : Prop :=
  t.all (fun (f, σ) =>
    inOrbitTrie t f.neg0.canon && inOrbitTrie t f.sw01.canon &&
    inOrbitTrie t f.sw12.canon && inOrbitTrie t f.sw23.canon &&
    (f.applyB4Canon σ == rep)) = true

private theorem orbit_elemOp {t : Trie15 (B16 × B4Code)} {rep : B16} (hc : OrbitClosed t rep)
    (op : ElemOp) {x : B16} (hx : inOrbitTrie t x = true) :
    inOrbitTrie t (op.apply x).canon = true := by
  have h4 : ∀ y, inOrbitTrie t y = true →
      inOrbitTrie t y.neg0.canon = true ∧ inOrbitTrie t y.sw01.canon = true ∧
      inOrbitTrie t y.sw12.canon = true ∧ inOrbitTrie t y.sw23.canon = true := by
    intro y hy
    obtain ⟨σ, hl⟩ := inOrbitTrie_spec hy
    have ha := trie15_lookup_all hc hl
    simp only [Bool.and_eq_true] at ha
    exact ⟨ha.1.1.1.1, ha.1.1.1.2, ha.1.1.2, ha.1.2⟩
  cases op
  · exact (h4 x hx).1
  · have hm : ElemOp.apply .neg1 x = x.sw01.neg0.sw01 := neg1_eq x
    have hstep1 : inOrbitTrie t (ElemOp.sw01.apply x).canon = true := (h4 x hx).2.1
    have hstep2 : inOrbitTrie t (ElemOp.neg0.apply (ElemOp.sw01.apply x).canon).canon = true := (h4 _ hstep1).1
    have hstep3 : inOrbitTrie t (ElemOp.sw01.apply (ElemOp.neg0.apply (ElemOp.sw01.apply x).canon).canon).canon = true := (h4 _ hstep2).2.1
    rw [canon_elemOp_canon .neg0 (ElemOp.sw01.apply x)] at hstep3
    rw [canon_elemOp_canon .sw01 (ElemOp.neg0.apply (ElemOp.sw01.apply x))] at hstep3
    simpa [hm] using hstep3
  · have h_neg1 : ∀ y, inOrbitTrie t y = true → inOrbitTrie t y.neg1.canon = true := by
      intro y hy
      have s1 : inOrbitTrie t (ElemOp.sw01.apply y).canon = true := (h4 y hy).2.1
      have s2 : inOrbitTrie t (ElemOp.neg0.apply (ElemOp.sw01.apply y).canon).canon = true := (h4 _ s1).1
      have s3 : inOrbitTrie t (ElemOp.sw01.apply (ElemOp.neg0.apply (ElemOp.sw01.apply y).canon).canon).canon = true := (h4 _ s2).2.1
      rw [canon_elemOp_canon .neg0 (ElemOp.sw01.apply y)] at s3
      rw [canon_elemOp_canon .sw01 (ElemOp.neg0.apply (ElemOp.sw01.apply y))] at s3
      simpa [neg1_eq y] using s3
    have s1 : inOrbitTrie t (ElemOp.sw12.apply x).canon = true := (h4 x hx).2.2.1
    have s2 : inOrbitTrie t (ElemOp.neg1.apply (ElemOp.sw12.apply x).canon).canon = true := h_neg1 _ s1
    have s3 : inOrbitTrie t (ElemOp.sw12.apply (ElemOp.neg1.apply (ElemOp.sw12.apply x).canon).canon).canon = true := (h4 _ s2).2.2.1
    rw [canon_elemOp_canon .neg1 (ElemOp.sw12.apply x)] at s3
    rw [canon_elemOp_canon .sw12 (ElemOp.neg1.apply (ElemOp.sw12.apply x))] at s3
    simpa [neg2_eq x] using s3
  · have h_neg1 : ∀ y, inOrbitTrie t y = true → inOrbitTrie t y.neg1.canon = true := by
      intro y hy
      have s1 : inOrbitTrie t (ElemOp.sw01.apply y).canon = true := (h4 y hy).2.1
      have s2 : inOrbitTrie t (ElemOp.neg0.apply (ElemOp.sw01.apply y).canon).canon = true := (h4 _ s1).1
      have s3 : inOrbitTrie t (ElemOp.sw01.apply (ElemOp.neg0.apply (ElemOp.sw01.apply y).canon).canon).canon = true := (h4 _ s2).2.1
      rw [canon_elemOp_canon .neg0 (ElemOp.sw01.apply y)] at s3
      rw [canon_elemOp_canon .sw01 (ElemOp.neg0.apply (ElemOp.sw01.apply y))] at s3
      simpa [neg1_eq y] using s3
    have h_neg2 : ∀ y, inOrbitTrie t y = true → inOrbitTrie t y.neg2.canon = true := by
      intro y hy
      have s1 : inOrbitTrie t (ElemOp.sw12.apply y).canon = true := (h4 y hy).2.2.1
      have s2 : inOrbitTrie t (ElemOp.neg1.apply (ElemOp.sw12.apply y).canon).canon = true := h_neg1 _ s1
      have s3 : inOrbitTrie t (ElemOp.sw12.apply (ElemOp.neg1.apply (ElemOp.sw12.apply y).canon).canon).canon = true := (h4 _ s2).2.2.1
      rw [canon_elemOp_canon .neg1 (ElemOp.sw12.apply y)] at s3
      rw [canon_elemOp_canon .sw12 (ElemOp.neg1.apply (ElemOp.sw12.apply y))] at s3
      simpa [neg2_eq y] using s3
    have s1 : inOrbitTrie t (ElemOp.sw23.apply x).canon = true := (h4 x hx).2.2.2
    have s2 : inOrbitTrie t (ElemOp.neg2.apply (ElemOp.sw23.apply x).canon).canon = true := h_neg2 _ s1
    have s3 : inOrbitTrie t (ElemOp.sw23.apply (ElemOp.neg2.apply (ElemOp.sw23.apply x).canon).canon).canon = true := (h4 _ s2).2.2.2
    rw [canon_elemOp_canon .neg2 (ElemOp.sw23.apply x)] at s3
    rw [canon_elemOp_canon .sw23 (ElemOp.neg2.apply (ElemOp.sw23.apply x))] at s3
    simpa [neg3_eq x] using s3
  · exact (h4 x hx).2.1
  · exact (h4 x hx).2.2.1
  · exact (h4 x hx).2.2.2


private theorem inOrbitTrie_applyOps {t : Trie15 (B16 × B4Code)} {rep : B16} (hc : OrbitClosed t rep) :
    ∀ (ops : List ElemOp) (x : B16), inOrbitTrie t x = true → inOrbitTrie t (applyOps ops x).canon = true
  | [], x, hx => by rw [applyOps, inOrbitTrie_canon hx]; exact hx
  | op :: rest, x, hx => by
      simp only [applyOps]
      rw [← applyOps_canon rest (op.apply x)]
      exact inOrbitTrie_applyOps hc rest (op.apply x).canon (orbit_elemOp hc op hx)

private theorem orbit_closed_applyB4Canon {t : Trie15 (B16 × B4Code)} {rep : B16}
    (hc : OrbitClosed t rep) (f : B16) (hf : inOrbitTrie t f = true) (c : B4Code) :
    inOrbitTrie t (f.applyB4Canon c) = true := by
  simp only [B16.applyB4Canon, applyB4_eq_applyOps]
  exact inOrbitTrie_applyOps hc c.toOps f hf

private theorem sum4_match (pts : List Pt4) :
    (((sum4 pts).1 : Int) = csum 0 (pts.map pt4ToFn)) ∧
    (((sum4 pts).2.1 : Int) = csum 1 (pts.map pt4ToFn)) ∧
    (((sum4 pts).2.2.1 : Int) = csum 2 (pts.map pt4ToFn)) ∧
    (((sum4 pts).2.2.2 : Int) = csum 3 (pts.map pt4ToFn)) := by
  have hc1 : ∀ a : Nat, ((a + 1 : Nat) : Int) = (a : Int) + 1 := fun _ => by omega
  induction pts with
  | nil => simp [sum4, csum]
  | cons p ps ih =>
      rcases ih with ⟨h0, h1, h2, h3⟩
      simp only [List.map_cons, sum4, csum, pt4ToFn, pt4]
      refine ⟨?_, ?_, ?_, ?_⟩
      · cases p.x0 <;> simp only [g5_b2i, g5_b2n, Nat.add_zero, hc1] <;> rw [h0] <;> omega
      · cases p.x1 <;> simp only [g5_b2i, g5_b2n, Nat.add_zero, hc1] <;> rw [h1] <;> omega
      · cases p.x2 <;> simp only [g5_b2i, g5_b2n, Nat.add_zero, hc1] <;> rw [h2] <;> omega
      · cases p.x3 <;> simp only [g5_b2i, g5_b2n, Nat.add_zero, hc1] <;> rw [h3] <;> omega

theorem eqSums4_no_ltf {g3 : B16} (hg3 : IsLtfB16 g3) (pos neg : List Pt4)
    (heq : eqSums4 pos neg = true)
    (hp : ∀ p, p ∈ pos → g3.atPt p = true)
    (hq : ∀ q, q ∈ neg → g3.atPt q = false) : False := by
  rcases hg3 with ⟨w, t, rfl⟩
  simp only [eqSums4, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at heq
  rcases heq with ⟨⟨hgt, hlen⟩, hsum⟩
  have h01 : (sum4 pos).1 = (sum4 neg).1 := congrArg Prod.fst hsum
  have h02 : (sum4 pos).2.1 = (sum4 neg).2.1 := congrArg (fun x => x.2.1) hsum
  have h03 : (sum4 pos).2.2.1 = (sum4 neg).2.2.1 := congrArg (fun x => x.2.2.1) hsum
  have h04 : (sum4 pos).2.2.2 = (sum4 neg).2.2.2 := congrArg (fun x => x.2.2.2) hsum
  have sp := sum4_match pos
  have sn := sum4_match neg
  apply not_threshold_cert_sound 4 (pos.map pt4ToFn) (neg.map pt4ToFn)
  · simp [hlen]
  · simp [hgt]
  · intro j hj
    match j, hj with
    | 0, _ => rw [← sp.1, ← sn.1, h01]
    | 1, _ => rw [← sp.2.1, ← sn.2.1, h02]
    | 2, _ => rw [← sp.2.2.1, ← sn.2.2.1, h03]
    | 3, _ => rw [← sp.2.2.2, ← sn.2.2.2, h04]
  · refine ⟨w, t, ?_, ?_⟩
    · intro x hx
      rw [List.mem_map] at hx
      rcases hx with ⟨p, hpm, rfl⟩
      have := hp p hpm
      rw [ltfB16_atPt, ltf4] at this
      exact of_decide_eq_true this
    · intro x hx
      rw [List.mem_map] at hx
      rcases hx with ⟨q, hqm, rfl⟩
      have := hq q hqm
      rw [ltfB16_atPt, ltf4] at this
      have hn : ¬ (t ≤ dot 4 w (pt4ToFn q)) := of_decide_eq_false this
      omega

private def signsOf (g3 : B16) : List (Bool × Bool × Pt4 × Pt4) → List Bool
  | [] => []
  | (_, _, a0, _) :: ts => g3.atPt a0 :: signsOf g3 ts

private def tagsAligned (Ψ : Bool → Bool → Bool → Bool) :
    List (Bool × Bool × Pt4 × Pt4) → List Bool → Prop
  | [], [] => True
  | (c1, c2, _, _) :: ts, s :: ss =>
      (Ψ c1 c2 s = true ∧ Ψ c1 c2 (!s) = false) ∧ tagsAligned Ψ ts ss
  | _, _ => False

private theorem tagsAligned_signsOf (g1 g2 g3 : B16) (Ψ : Bool → Bool → Bool → Bool)
    (hdet : ∀ p, Ψ (g1.atPt p) (g2.atPt p) (g3.atPt p) = p4B16.atPt p) :
    ∀ tags, tags.all (fun (c1, c2, a0, b0) =>
      g1.atPt a0 == c1 && g2.atPt a0 == c2 && p4B16.atPt a0 == true &&
      g1.atPt b0 == c1 && g2.atPt b0 == c2 && p4B16.atPt b0 == false) = true →
    tagsAligned Ψ tags (signsOf g3 tags)
  | [], _ => trivial
  | (c1, c2, a0, b0) :: ts, h => by
      simp only [List.all_cons, Bool.and_eq_true, beq_iff_eq] at h
      rcases h with ⟨⟨⟨⟨⟨⟨ha1, ha2⟩, hap⟩, hb1⟩, hb2⟩, hbp⟩, hrest⟩
      refine ⟨⟨?_, ?_⟩, tagsAligned_signsOf g1 g2 g3 Ψ hdet ts hrest⟩
      · have := hdet a0; rw [ha1, ha2, hap] at this; exact this
      · have ha := hdet a0
        have hb := hdet b0
        cases hs : g3.atPt a0 <;> cases hgb : g3.atPt b0 <;> simp_all

private theorem bool_tag_force (Ψc : Bool → Bool) (s flipWant u : Bool)
    (ht : Ψc s = true) (hf : Ψc (!s) = false)
    (hm : Ψc u = (if flipWant then !s else s)) :
    u = !flipWant := by
  cases s <;> cases flipWant <;> cases u <;> simp_all

private theorem ptMatchesSign_sound (g1 g2 g3 : B16) (Ψ : Bool → Bool → Bool → Bool)
    (hdet : ∀ p, Ψ (g1.atPt p) (g2.atPt p) (g3.atPt p) = p4B16.atPt p)
    (pt : Pt4) (flipWant : Bool) :
    ∀ tags signs, tagsAligned Ψ tags signs →
      ptMatchesSign g1 g2 pt flipWant tags signs = true →
      g3.atPt pt = !flipWant
  | (c1, c2, _, _) :: ts, s :: ss, ⟨⟨ht, hf⟩, hrest⟩, hpm => by
      simp only [ptMatchesSign, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq] at hpm
      rcases hpm with ⟨⟨hg1, hg2⟩, hp4⟩ | htail
      · have h := hdet pt
        rw [hg1, hg2, hp4] at h
        exact bool_tag_force (Ψ c1 c2) s flipWant (g3.atPt pt) ht hf h
      · exact ptMatchesSign_sound g1 g2 g3 Ψ hdet pt flipWant ts ss hrest htail
  | [], _, _, hpm => by simp [ptMatchesSign] at hpm
  | _ :: _, [], _, hpm => by simp [ptMatchesSign] at hpm

private theorem signsOf_mem_signMasks (g3 : B16) :
    ∀ tags, tags.length > 0 → tags.length ≤ 4 →
      (match tags with | [] => true | (_, _, a0, _) :: _ => g3.atPt a0) = true →
      signsOf g3 tags ∈ signMasks tags.length
  | [(_, _, a0, _)], _, _, hh => by
      simp only [signsOf, signMasks] at hh ⊢; simp [hh]
  | [(_, _, a0, _), (_, _, a1, _)], _, _, hh => by
      simp only [signsOf, signMasks] at hh ⊢
      cases h1 : g3.atPt a1 <;> simp [hh, h1]
  | [(_, _, a0, _), (_, _, a1, _), (_, _, a2, _)], _, _, hh => by
      simp only [signsOf, signMasks] at hh ⊢
      cases h1 : g3.atPt a1 <;> cases h2 : g3.atPt a2 <;> simp [hh, h1, h2]
  | [(_, _, a0, _), (_, _, a1, _), (_, _, a2, _), (_, _, a3, _)], _, _, hh => by
      simp only [signsOf, signMasks] at hh ⊢
      cases h1 : g3.atPt a1 <;> cases h2 : g3.atPt a2 <;> cases h3 : g3.atPt a3 <;> simp [hh, h1, h2, h3]
  | _ :: _ :: _ :: _ :: _ :: _, _, hle, _ => by simp at hle
  | [], hgt, _, _ => by simp at hgt

private theorem checkMultiWitsList_find (g1 g2 : B16) (tags : List (Bool × Bool × Pt4 × Pt4)) (target : List Bool) :
    ∀ masks wits, checkMultiWitsList g1 g2 tags masks wits = true → target ∈ masks →
      ∃ pos neg, eqSums4 pos neg = true ∧
        pos.all (fun p => ptMatchesSign g1 g2 p false tags target) = true ∧
        neg.all (fun q => ptMatchesSign g1 g2 q true tags target) = true
  | m :: ms, (pos, neg) :: ws, hok, hmem => by
      simp only [checkMultiWitsList, Bool.and_eq_true] at hok
      simp only [List.mem_cons] at hmem
      rcases hmem with rfl | htail
      · exact ⟨pos, neg, hok.1.1.1, hok.1.1.2, hok.1.2⟩
      · exact checkMultiWitsList_find g1 g2 tags target ms ws hok.2 htail
  | [], _, _, hmem => by simp at hmem
  | _ :: _, [], hok, _ => by simp [checkMultiWitsList] at hok

theorem checkPairCertB_sound (g1 : B16) (crt : PairCertB)
    (hok : checkPairCertB g1 crt = true) :
    ¬ ∃ (g3 : B16) (Ψ : Bool → Bool → Bool → Bool),
      IsLtfB16 g3 ∧ ∀ p : Pt4, Ψ (g1.atPt p) (crt.g2.atPt p) (g3.atPt p) = p4B16.atPt p := by
  intro ⟨g3, Ψ, hg3, hdet⟩
  cases crt with
  | single g2 c1 c2 pos neg =>
      simp only [PairCertB.g2] at hdet
      simp only [checkPairCertB, Bool.and_eq_true, List.all_eq_true, beq_iff_eq] at hok
      rcases hok with ⟨⟨heq, hpos⟩, hneg⟩
      have hb : ∃ pos_val : Bool, ∀ p ∈ pos, g3.atPt p = pos_val := by
        cases hcT : Ψ c1 c2 true <;> cases hcF : Ψ c1 c2 false
        · exfalso
          have hgt : 0 < pos.length := by simp only [eqSums4, Bool.and_eq_true, decide_eq_true_eq] at heq; exact heq.1.1
          cases pos with
          | nil => simp at hgt
          | cons p0 _ =>
              obtain ⟨⟨hp1, hp2⟩, hp3⟩ := hpos p0 (List.mem_cons_self _ _)
              have h := hdet p0; rw [hp1, hp2, hp3] at h
              cases hx : g3.atPt p0 <;> simp_all
        · refine ⟨false, fun p hp => ?_⟩
          obtain ⟨⟨hp1, hp2⟩, hp3⟩ := hpos p hp
          have h := hdet p; rw [hp1, hp2, hp3] at h
          cases hx : g3.atPt p <;> simp_all
        · refine ⟨true, fun p hp => ?_⟩
          obtain ⟨⟨hp1, hp2⟩, hp3⟩ := hpos p hp
          have h := hdet p; rw [hp1, hp2, hp3] at h
          cases hx : g3.atPt p <;> simp_all
        · exfalso
          have hgt : 0 < neg.length := by
            simp only [eqSums4, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at heq; omega
          cases neg with
          | nil => simp at hgt
          | cons q0 _ =>
              obtain ⟨⟨hq1, hq2⟩, hq3⟩ := hneg q0 (List.mem_cons_self _ _)
              have h := hdet q0; rw [hq1, hq2, hq3] at h
              cases hx : g3.atPt q0 <;> simp_all
      rcases hb with ⟨pos_val, hpos_g⟩
      cases pos_val
      · apply eqSums4_no_ltf (isLtf_not hg3) pos neg heq
        · intro p hp
          rw [atPt_not, hpos_g p hp]; rfl
        · intro q hq
          obtain ⟨⟨hq1, hq2⟩, hq3⟩ := hneg q hq
          have h := hdet q; rw [hq1, hq2, hq3] at h
          have hpf : Ψ c1 c2 false = true := by
            cases pos with
            | nil => simp only [eqSums4, Bool.and_eq_true, decide_eq_true_eq] at heq; simp at heq
            | cons p0 _ =>
                obtain ⟨⟨hp1, hp2⟩, hp3⟩ := hpos p0 (List.mem_cons_self _ _)
                have h0 := hdet p0; rw [hp1, hp2, hp3, hpos_g p0 (List.mem_cons_self _ _)] at h0; exact h0
          have hgq : g3.atPt q = true := by
            cases hgq' : g3.atPt q
            · rw [hgq', hpf] at h; cases h
            · rfl
          rw [atPt_not, hgq]; rfl
      · apply eqSums4_no_ltf hg3 pos neg heq hpos_g
        intro q hq
        obtain ⟨⟨hq1, hq2⟩, hq3⟩ := hneg q hq
        have h := hdet q; rw [hq1, hq2, hq3] at h
        have hpt : Ψ c1 c2 true = true := by
          cases pos with
          | nil => simp only [eqSums4, Bool.and_eq_true, decide_eq_true_eq] at heq; simp at heq
          | cons p0 _ =>
              obtain ⟨⟨hp1, hp2⟩, hp3⟩ := hpos p0 (List.mem_cons_self _ _)
              have h0 := hdet p0; rw [hp1, hp2, hp3, hpos_g p0 (List.mem_cons_self _ _)] at h0; exact h0
        cases hgq' : g3.atPt q
        · rfl
        · rw [hgq', hpt] at h; cases h
  | multi g2 tags wits =>
      simp only [PairCertB.g2] at hdet
      simp only [checkPairCertB, Bool.and_eq_true, decide_eq_true_eq] at hok
      rcases hok with ⟨⟨⟨hgt, hle⟩, htags⟩, hwits⟩
      cases tags with
      | nil => simp at hgt
      | cons hd ts =>
          rcases hd with ⟨hc1, hc2, a0, b0⟩
          have norm : ∃ (g3' : B16) (Ψ' : Bool → Bool → Bool → Bool), IsLtfB16 g3' ∧
              (∀ p : Pt4, Ψ' (g1.atPt p) (g2.atPt p) (g3'.atPt p) = p4B16.atPt p) ∧
              g3'.atPt a0 = true := by
            cases h0 : g3.atPt a0
            · refine ⟨g3.not, fun a b c => Ψ a b (!c), isLtf_not hg3, fun p => ?_, ?_⟩
              · dsimp only
                rw [atPt_not, Bool.not_not, hdet p]
              · rw [atPt_not, h0]; rfl
            · exact ⟨g3, Ψ, hg3, hdet, h0⟩
          rcases norm with ⟨g3', Ψ', hg3', hdet', ha0⟩
          have hal := tagsAligned_signsOf g1 g2 g3' Ψ' hdet' ((hc1, hc2, a0, b0) :: ts) htags
          have hmem := signsOf_mem_signMasks g3' ((hc1, hc2, a0, b0) :: ts) hgt hle ha0
          obtain ⟨pos, neg, heqs, hpm, hqm⟩ :=
            checkMultiWitsList_find g1 g2 ((hc1, hc2, a0, b0) :: ts) (signsOf g3' ((hc1, hc2, a0, b0) :: ts))
              (signMasks ((hc1, hc2, a0, b0) :: ts).length) wits hwits hmem
          apply eqSums4_no_ltf hg3' pos neg heqs
          · intro p hp
            exact ptMatchesSign_sound g1 g2 g3' Ψ' hdet' p false _ _ hal (List.all_eq_true.mp hpm p hp)
          · intro q hq
            exact ptMatchesSign_sound g1 g2 g3' Ψ' hdet' q true _ _ hal (List.all_eq_true.mp hqm q hq)

private theorem b16_not_not (f : B16) : f.not.not = f := by
  rcases f with ⟨b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15⟩
  simp [B16.not]

private theorem canon_eq_allFalse_iff (x : B16) :
    x.canon = allFalseB16 ↔ x = allFalseB16 ∨ x = allFalseB16.not := by
  constructor
  · intro h
    rw [canon_eq_ite] at h
    cases hb : x.b0
    · rw [hb] at h; simp at h; exact Or.inl h
    · rw [hb] at h; simp only [↓reduceIte] at h
      have hn := congrArg B16.not h
      rw [b16_not_not] at hn
      exact Or.inr hn
  · intro h
    rcases h with rfl | rfl <;> rfl



private theorem isClassified_elemOp (op : ElemOp) {x : B16} (hx : isClassifiedCanon x.canon = true) :
    isClassifiedCanon (op.apply x).canon = true := by
  by_cases hc : x.canon = allFalseB16
  · have hcf : (op.apply x).canon = allFalseB16 := by
      rcases (canon_eq_allFalse_iff x).mp hc with rfl | rfl
      · rw [elemOp_allFalse]; rfl
      · rw [elemOp_allTrue]; rfl
    simp [isClassifiedCanon, hcf]

  · by_cases ho0 : inOrbitTrie orbitTrie_0 x.canon = true
    · have hnext := orbit_elemOp t_orbit_closed_0 op ho0
      rw [canon_elemOp_canon] at hnext
      simp [isClassifiedCanon, hnext]
    · by_cases ho1 : inOrbitTrie orbitTrie_1 x.canon = true
      · have hnext := orbit_elemOp t_orbit_closed_1 op ho1
        rw [canon_elemOp_canon] at hnext
        simp [isClassifiedCanon, hnext]
      · by_cases ho2 : inOrbitTrie orbitTrie_2 x.canon = true
        · have hnext := orbit_elemOp t_orbit_closed_2 op ho2
          rw [canon_elemOp_canon] at hnext
          simp [isClassifiedCanon, hnext]
        · by_cases ho3 : inOrbitTrie orbitTrie_3 x.canon = true
          · have hnext := orbit_elemOp t_orbit_closed_3 op ho3
            rw [canon_elemOp_canon] at hnext
            simp [isClassifiedCanon, hnext]
          · by_cases ho4 : inOrbitTrie orbitTrie_4 x.canon = true
            · have hnext := orbit_elemOp t_orbit_closed_4 op ho4
              rw [canon_elemOp_canon] at hnext
              simp [isClassifiedCanon, hnext]
            · by_cases ho5 : inOrbitTrie orbitTrie_5 x.canon = true
              · have hnext := orbit_elemOp t_orbit_closed_5 op ho5
                rw [canon_elemOp_canon] at hnext
                simp [isClassifiedCanon, hnext]
              · by_cases ho6 : inOrbitTrie orbitTrie_6 x.canon = true
                · have hnext := orbit_elemOp t_orbit_closed_6 op ho6
                  rw [canon_elemOp_canon] at hnext
                  simp [isClassifiedCanon, hnext]
                · by_cases ho7 : inOrbitTrie orbitTrie_7 x.canon = true
                  · have hnext := orbit_elemOp t_orbit_closed_7 op ho7
                    rw [canon_elemOp_canon] at hnext
                    simp [isClassifiedCanon, hnext]
                  · by_cases ho8 : inOrbitTrie orbitTrie_8 x.canon = true
                    · have hnext := orbit_elemOp t_orbit_closed_8 op ho8
                      rw [canon_elemOp_canon] at hnext
                      simp [isClassifiedCanon, hnext]
                    · by_cases ho9 : inOrbitTrie orbitTrie_9 x.canon = true
                      · have hnext := orbit_elemOp t_orbit_closed_9 op ho9
                        rw [canon_elemOp_canon] at hnext
                        simp [isClassifiedCanon, hnext]
                      · by_cases ho10 : inOrbitTrie orbitTrie_10 x.canon = true
                        · have hnext := orbit_elemOp t_orbit_closed_10 op ho10
                          rw [canon_elemOp_canon] at hnext
                          simp [isClassifiedCanon, hnext]
                        · by_cases ho11 : inOrbitTrie orbitTrie_11 x.canon = true
                          · have hnext := orbit_elemOp t_orbit_closed_11 op ho11
                            rw [canon_elemOp_canon] at hnext
                            simp [isClassifiedCanon, hnext]
                          · by_cases ho12 : inOrbitTrie orbitTrie_12 x.canon = true
                            · have hnext := orbit_elemOp t_orbit_closed_12 op ho12
                              rw [canon_elemOp_canon] at hnext
                              simp [isClassifiedCanon, hnext]
                            · by_cases ho13 : inOrbitTrie orbitTrie_13 x.canon = true
                              · have hnext := orbit_elemOp t_orbit_closed_13 op ho13
                                rw [canon_elemOp_canon] at hnext
                                simp [isClassifiedCanon, hnext]
                              · have hcb : (x.canon == allFalseB16) = false := by cases h : (x.canon == allFalseB16) with | false => rfl | true => exact absurd (b16_beq_eq h) hc
                                simp only [isClassifiedCanon, hcb, ho0, ho1, ho2, ho3, ho4, ho5, ho6, ho7, ho8, ho9, ho10, ho11, ho12, ho13, Bool.or_false] at hx
                                cases hx

private theorem isClassified_applyOps :
    ∀ (ops : List ElemOp) (x : B16), isClassifiedCanon x.canon = true → isClassifiedCanon (applyOps ops x).canon = true
  | [], x, hx => hx
  | op :: rest, x, hx => by
      simp only [applyOps]
      rw [← applyOps_canon rest (op.apply x)]
      exact isClassified_applyOps rest (op.apply x).canon (by rw [canon_canon]; exact isClassified_elemOp op hx)

theorem ltf_classified {g : B16} (hg : IsLtfB16 g) : isClassifiedCanon g.canon = true := by
  rcases hg with ⟨w, t, rfl⟩
  rcases regularize_ltf w t with ⟨ops, w', t', hm, hops⟩
  have hr := monotone_isRegular t' hm
  have hc := isRegular_classified (ltfB16 w' t') hr
  have hrev := isClassified_applyOps ops.reverse (ltfB16 w' t') hc
  rw [← hops, applyOps_reverse] at hrev
  exact hrev

private theorem const_const_absurd {g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hg3 : IsLtfB16 g3)
    (hdet : ∀ p : Pt4, Ψ (allFalseB16.atPt p) (allFalseB16.atPt p) (g3.atPt p) = p4B16.atPt p) : False :=
  checkPairCertB_sound allFalseB16 constConstCert t_const_const ⟨g3, Ψ, hg3, hdet⟩

private theorem const_orbit_absurd {rep : B16} {t : Trie15 (B16 × B4Code)} {crt : PairCertB}
    (hc : OrbitClosed t rep) (hcrt : checkPairCertB allFalseB16 crt = true) (hg2eq : crt.g2 = rep)
    {f g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hf : inOrbitTrie t f = true) (hg3 : IsLtfB16 g3)
    (hdet : ∀ p : Pt4, Ψ (allFalseB16.atPt p) (f.atPt p) (g3.atPt p) = p4B16.atPt p) : False := by
  obtain ⟨σ, hl⟩ := inOrbitTrie_spec hf
  have ha := trie15_lookup_all hc hl
  simp only [Bool.and_eq_true, beq_iff_eq] at ha
  have hrep : f.applyB4Canon σ = rep := ha.2
  rcases det_applyB4Canon σ hg3 hdet with ⟨g3', Ψ', hg3', hdet'⟩
  rw [applyB4Canon_allFalse, hrep, ← hg2eq] at hdet'
  exact checkPairCertB_sound allFalseB16 crt hcrt ⟨g3', Ψ', hg3', hdet'⟩

private theorem pair_absurd_of_orbits
    {rep1 rep2 : B16} {t1 t2 : Trie15 (B16 × B4Code)}
    {stab1 : ITrie B4Code} {cert1 : ITrie PairCertB} {certG2 : ITrie B16}
    {wit : Trie15 (Bits7 × Bits10)}
    (hc1 : OrbitClosed t1 rep1) (hc2 : OrbitClosed t2 rep2)
    (hstab : stab1.all (fun τ => rep1.applyB4Canon τ == rep1) = true)
    (hcerts : cert1.all (checkPairCertB rep1) = true)
    (hcertG2 : ITrie.zipAll (fun crt g2 => crt.g2 == g2) cert1 certG2 = true)
    (hpair : Trie15.zipAll (fun (g, _) (si, cid) =>
      match stab1.get7? si, certG2.get10? cid with
      | some τ, some g2 => g.applyB4Canon τ == g2 | _, _ => false) t2 wit = true)
    {f1 f2 g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hf1 : inOrbitTrie t1 f1 = true) (hf2 : inOrbitTrie t2 f2 = true) (hg3 : IsLtfB16 g3)
    (hdet : ∀ p : Pt4, Ψ (f1.atPt p) (f2.atPt p) (g3.atPt p) = p4B16.atPt p) : False := by
  obtain ⟨σ1, hl1⟩ := inOrbitTrie_spec hf1
  have ha1 := trie15_lookup_all hc1 hl1
  simp only [Bool.and_eq_true, beq_iff_eq] at ha1
  have hrep1 : f1.applyB4Canon σ1 = rep1 := ha1.2
  have hf2' : inOrbitTrie t2 (f2.applyB4Canon σ1) = true := orbit_closed_applyB4Canon hc2 f2 hf2 σ1
  rcases det_applyB4Canon σ1 hg3 hdet with ⟨g3', Ψ', hg3', hdet'⟩
  rw [hrep1] at hdet'
  obtain ⟨_, hl2'⟩ := inOrbitTrie_spec hf2'
  obtain ⟨⟨si, cid⟩, _, hpm⟩ := trie15_lookup_zipAll hpair hl2'
  dsimp only at hpm
  cases hτ : stab1.get7? si with
  | none => rw [hτ] at hpm; cases hpm
  | some τ =>
      cases hc2g : certG2.get10? cid with
      | none => rw [hτ, hc2g] at hpm; cases hpm
      | some c_g2 =>
          rw [hτ, hc2g] at hpm
          have hfg2 : (f2.applyB4Canon σ1).applyB4Canon τ = c_g2 := b16_beq_eq hpm
          have hτrep : rep1.applyB4Canon τ = rep1 :=
            b16_beq_eq (itrie_get7?_all (p := fun τ => rep1.applyB4Canon τ == rep1) hstab hτ)
          obtain ⟨crt, hcrt_get, hcrt_eq⟩ := itrie_get10?_zipAll_right hcertG2 hc2g
          have hcrt_g2 : crt.g2 = c_g2 := b16_beq_eq hcrt_eq
          have hcrt_ok : checkPairCertB rep1 crt = true := itrie_get10?_all hcerts hcrt_get
          rcases det_applyB4Canon τ hg3' hdet' with ⟨g3'', Ψ'', hg3'', hdet''⟩
          rw [hτrep, hfg2, ← hcrt_g2] at hdet''
          exact checkPairCertB_sound rep1 crt hcrt_ok ⟨g3'', Ψ'', hg3'', hdet''⟩

private theorem const_orbit_absurd_swap {rep : B16} {t : Trie15 (B16 × B4Code)} {crt : PairCertB}
    (hc : OrbitClosed t rep) (hcrt : checkPairCertB allFalseB16 crt = true) (hg2eq : crt.g2 = rep)
    {f g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hf : inOrbitTrie t f = true) (hg3 : IsLtfB16 g3)
    (hdet : ∀ p : Pt4, Ψ (f.atPt p) (allFalseB16.atPt p) (g3.atPt p) = p4B16.atPt p) : False :=
  const_orbit_absurd (Ψ := fun a b c => Ψ b a c) hc hcrt hg2eq hf hg3 hdet

private theorem pair_absurd_of_orbits_swap
    {rep1 rep2 : B16} {t1 t2 : Trie15 (B16 × B4Code)}
    {stab1 : ITrie B4Code} {cert1 : ITrie PairCertB} {certG2 : ITrie B16}
    {wit : Trie15 (Bits7 × Bits10)}
    (hc1 : OrbitClosed t1 rep1) (hc2 : OrbitClosed t2 rep2)
    (hstab : stab1.all (fun τ => rep1.applyB4Canon τ == rep1) = true)
    (hcerts : cert1.all (checkPairCertB rep1) = true)
    (hcertG2 : ITrie.zipAll (fun crt g2 => crt.g2 == g2) cert1 certG2 = true)
    (hpair : Trie15.zipAll (fun (g, _) (si, cid) =>
      match stab1.get7? si, certG2.get10? cid with
      | some τ, some g2 => g.applyB4Canon τ == g2 | _, _ => false) t2 wit = true)
    {f1 f2 g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hf1 : inOrbitTrie t1 f1 = true) (hf2 : inOrbitTrie t2 f2 = true) (hg3 : IsLtfB16 g3)
    (hdet : ∀ p : Pt4, Ψ (f2.atPt p) (f1.atPt p) (g3.atPt p) = p4B16.atPt p) : False :=
  pair_absurd_of_orbits (Ψ := fun a b c => Ψ b a c) hc1 hc2 hstab hcerts hcertG2 hpair hf1 hf2 hg3 hdet


private theorem const_any_absurd {f2 g3 : B16} {Ψ : Bool → Bool → Bool → Bool}
    (hg3 : IsLtfB16 g3) (h2 : isClassifiedCanon f2 = true)
