private abbrev T := true
private abbrev F := false

structure B16 where
  (b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 : Bool)
  deriving DecidableEq

def B16.not : B16 → B16
  | ⟨b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15⟩ =>
    ⟨!b0,!b1,!b2,!b3,!b4,!b5,!b6,!b7,!b8,!b9,!b10,!b11,!b12,!b13,!b14,!b15⟩
