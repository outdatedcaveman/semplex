def ltf4 (w : Nat → Int) (t : Int) (p : Pt4) : Bool := decide (t ≤ dot 4 w (pt4ToFn p))

def ltfB16 (w : Nat → Int) (t : Int) : B16 :=
  ⟨ltf4 w t ⟨F,F,F,F⟩, ltf4 w t ⟨T,F,F,F⟩, ltf4 w t ⟨F,T,F,F⟩, ltf4 w t ⟨T,T,F,F⟩,
   ltf4 w t ⟨F,F,T,F⟩, ltf4 w t ⟨T,F,T,F⟩, ltf4 w t ⟨F,T,T,F⟩, ltf4 w t ⟨T,T,T,F⟩,
   ltf4 w t ⟨F,F,F,T⟩, ltf4 w t ⟨T,F,F,T⟩, ltf4 w t ⟨F,T,F,T⟩, ltf4 w t ⟨T,T,F,T⟩,
   ltf4 w t ⟨F,F,T,T⟩, ltf4 w t ⟨T,F,T,T⟩, ltf4 w t ⟨F,T,T,T⟩, ltf4 w t ⟨T,T,T,T⟩⟩

theorem ltfB16_atPt (w : Nat → Int) (t : Int) (p : Pt4) :
    (ltfB16 w t).atPt p = ltf4 w t p := by
  cases p; rename_i x0 x1 x2 x3
  cases x0 <;> cases x1 <;> cases x2 <;> cases x3 <;> rfl

theorem p4B16_atPt_eq_parity4 (p : Pt4) :
    p4B16.atPt p = parity4 (pt4ToFn p) := by
  cases p; rename_i x0 x1 x2 x3
  cases x0 <;> cases x1 <;> cases x2 <;> cases x3 <;> rfl

private theorem pt4ToFn_bool (p : Pt4) : ∀ j, j < 4 → pt4ToFn p j = 0 ∨ pt4ToFn p j = 1 := by
  rcases p with ⟨x0, x1, x2, x3⟩
  intro j hj
  match j, hj with
  | 0, _ => cases x0 <;> simp [pt4ToFn, pt4, g5_b2i]
  | 1, _ => cases x1 <;> simp [pt4ToFn, pt4, g5_b2i]
  | 2, _ => cases x2 <;> simp [pt4ToFn, pt4, g5_b2i]
  | 3, _ => cases x3 <;> simp [pt4ToFn, pt4, g5_b2i]

def IsLtfB16 (g : B16) : Prop := ∃ (w : Nat → Int) (t : Int), g = ltfB16 w t

private theorem g5_decide_iff {P Q : Prop} [Decidable P] [Decidable Q] (h : P ↔ Q) :
    decide P = decide Q := by
  by_cases hp : P
  · simp [hp, h.mp hp]
  · have hq : ¬ Q := mt h.mpr hp
    simp [hp, hq]

private theorem b16_ext (f g : B16) (h : ∀ p : Pt4, f.atPt p = g.atPt p) : f = g := by
  have h0 := h ⟨F,F,F,F⟩; have h1 := h ⟨T,F,F,F⟩; have h2 := h ⟨F,T,F,F⟩; have h3 := h ⟨T,T,F,F⟩
  have h4 := h ⟨F,F,T,F⟩; have h5 := h ⟨T,F,T,F⟩; have h6 := h ⟨F,T,T,F⟩; have h7 := h ⟨T,T,T,F⟩
  have h8 := h ⟨F,F,F,T⟩; have h9 := h ⟨T,F,F,T⟩; have h10 := h ⟨F,T,F,T⟩; have h11 := h ⟨T,T,F,T⟩
  have h12 := h ⟨F,F,T,T⟩; have h13 := h ⟨T,F,T,T⟩; have h14 := h ⟨F,T,T,T⟩; have h15 := h ⟨T,T,T,T⟩
  cases f; cases g
  simp only [B16.atPt] at h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15
  congr

private theorem g5_dot_neg (w p : Nat → Int) : ∀ n, dot n (fun j => - w j) p = - dot n w p
  | 0 => rfl
  | n + 1 => by
      have ih := g5_dot_neg w p n
      unfold dot
      simp only [ih, Int.neg_mul]
      omega

private theorem atPt_not (f : B16) (p : Pt4) : f.not.atPt p = !(f.atPt p) := by
  cases f; cases p; rename_i x0 x1 x2 x3; cases x0 <;> cases x1 <;> cases x2 <;> cases x3 <;> rfl

theorem isLtf_not {g : B16} (hg : IsLtfB16 g) : IsLtfB16 g.not := by
  rcases hg with ⟨w, t, rfl⟩
  refine ⟨fun j => -w j, 1 - t, b16_ext _ _ (fun p => ?_)⟩
  rw [ltfB16_atPt, atPt_not, ltfB16_atPt, ltf4, ltf4, g5_dot_neg]
  by_cases h : t ≤ dot 4 w (pt4ToFn p)
  · have h1 : ¬ (1 - t ≤ -dot 4 w (pt4ToFn p)) := by omega
    simp [h, h1]
  · have h1 : 1 - t ≤ -dot 4 w (pt4ToFn p) := by omega
    simp [h, h1]

private theorem canon_eq_ite (f : B16) : f.canon = if f.b0 then f.not else f := by
  cases f; rename_i b0 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
  cases b0 <;> rfl

theorem isLtf_canon {g : B16} (hg : IsLtfB16 g) : IsLtfB16 g.canon := by
  rw [canon_eq_ite]
  by_cases hb : g.b0 = true
  · simp [hb, isLtf_not hg]
  · simp [hb, hg]

private theorem neg0_ltf (w : Nat → Int) (t : Int) :
    (ltfB16 w t).neg0 = ltfB16 (pt4 (-w 0) (w 1) (w 2) (w 3)) (t - w 0) := by
  apply b16_ext; intro p
  have ha : (ltfB16 w t).neg0.atPt p = (ltfB16 w t).atPt ⟨!p.x0, p.x1, p.x2, p.x3⟩ := by
    cases p; rename_i x0 x1 x2 x3; cases x0 <;> cases x1 <;> cases x2 <;> cases x3 <;> rfl
  rw [ha, ltfB16_atPt, ltfB16_atPt, ltf4, ltf4]
  apply g5_decide_iff
  simp only [dot, pt4ToFn, pt4, g5_b2i]
  cases p.x0 <;> simp <;> omega

