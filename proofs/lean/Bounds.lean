@[inline] def B16.atPt (f : B16) (p : Pt4) : Bool :=
  if p.x3 then
    if p.x2 then if p.x1 then if p.x0 then f.b15 else f.b14 else if p.x0 then f.b13 else f.b12
    else if p.x1 then if p.x0 then f.b11 else f.b10 else if p.x0 then f.b9 else f.b8
  else
    if p.x2 then if p.x1 then if p.x0 then f.b7 else f.b6 else if p.x0 then f.b5 else f.b4
    else if p.x1 then if p.x0 then f.b3 else f.b2 else if p.x0 then f.b1 else f.b0

def p4B16 : B16 := ⟨F,T,T,F,T,F,F,T,T,F,F,T,F,T,T,F⟩
def allFalseB16 : B16 := ⟨F,F,F,F,F,F,F,F,F,F,F,F,F,F,F,F⟩
private def g5_b2i : Bool → Int | true => 1 | false => 0
private def g5_b2n : Bool → Nat | true => 1 | false => 0
def pt4ToFn (p : Pt4) : Nat → Int := pt4 (g5_b2i p.x0) (g5_b2i p.x1) (g5_b2i p.x2) (g5_b2i p.x3)
def parity4 (x : Nat → Int) : Bool :=
  (decide (x 0 = 1) != decide (x 1 = 1)) != (decide (x 2 = 1) != decide (x 3 = 1))
def sum4 : List Pt4 → Nat × Nat × Nat × Nat
  | [] => (0, 0, 0, 0)
  | p :: ps => let (s0,s1,s2,s3) := sum4 ps; (s0 + g5_b2n p.x0, s1 + g5_b2n p.x1, s2 + g5_b2n p.x2, s3 + g5_b2n p.x3)
def eqSums4 (pos neg : List Pt4) : Bool :=
  pos.length > 0 && pos.length == neg.length && sum4 pos == sum4 neg

inductive PairCertB where
  | single (g2 : B16) (c1 c2 : Bool) (pos neg : List Pt4)
  | multi (g2 : B16) (tags : List (Bool × Bool × Pt4 × Pt4)) (wits : List (List Pt4 × List Pt4))

def PairCertB.g2 : PairCertB → B16 | .single g2 _ _ _ _ => g2 | .multi g2 _ _ => g2

def signMasks : Nat → List (List Bool)
  | 1 => [[T]]
  | 2 => [[T,T], [T,F]]
  | 3 => [[T,T,T], [T,F,T], [T,T,F], [T,F,F]]
  | 4 => [[T,T,T,T], [T,F,T,T], [T,T,F,T], [T,F,F,T], [T,T,T,F], [T,F,T,F], [T,T,F,F], [T,F,F,F]]
  | _ => []

def ptMatchesSign (g1 g2 : B16) (pt : Pt4) (flipWant : Bool) : List (Bool × Bool × Pt4 × Pt4) → List Bool → Bool
  | (c1, c2, _, _) :: ts, s :: ss =>
    let want := if flipWant then !s else s
    (g1.atPt pt == c1 && g2.atPt pt == c2 && p4B16.atPt pt == want) || ptMatchesSign g1 g2 pt flipWant ts ss
  | _, _ => false

def checkMultiWitsList (g1 g2 : B16) (tags : List (Bool × Bool × Pt4 × Pt4)) : List (List Bool) → List (List Pt4 × List Pt4) → Bool
  | [], [] => true
  | signs :: srest, (pos, neg) :: wrest =>
    eqSums4 pos neg &&
    pos.all (fun p => ptMatchesSign g1 g2 p false tags signs) &&
    neg.all (fun q => ptMatchesSign g1 g2 q true tags signs) &&
    checkMultiWitsList g1 g2 tags srest wrest
  | _, _ => false

def checkPairCertB (g1 : B16) : PairCertB → Bool
  | .single g2 c1 c2 pos neg =>
    eqSums4 pos neg &&
    pos.all (fun p => g1.atPt p == c1 && g2.atPt p == c2 && p4B16.atPt p == true) &&
    neg.all (fun q => g1.atPt q == c1 && g2.atPt q == c2 && p4B16.atPt q == false)
  | .multi g2 tags wits =>
    let okTags := tags.length > 0 && tags.length ≤ 4 && tags.all (fun (c1, c2, a0, b0) => g1.atPt a0 == c1 && g2.atPt a0 == c2 && p4B16.atPt a0 == true && g1.atPt b0 == c1 && g2.atPt b0 == c2 && p4B16.atPt b0 == false)
    okTags && checkMultiWitsList g1 g2 tags (signMasks tags.length) wits

inductive ITrie (α : Type) where | empty | leaf : α → ITrie α | branch : ITrie α → ITrie α → ITrie α
@[inline] def ITrie.step {α : Type} (b : Bool) : ITrie α → ITrie α | .branch l r => if b then r else l | _ => .empty
def ITrie.get7? {α : Type} (k : Bits7) (t : ITrie α) : Option α :=
  match ITrie.step k.k0 (ITrie.step k.k1 (ITrie.step k.k2 (ITrie.step k.k3 (ITrie.step k.k4 (ITrie.step k.k5 (ITrie.step k.k6 t)))))) with
  | .leaf v => some v | _ => none
def ITrie.get10? {α : Type} (k : Bits10) (t : ITrie α) : Option α :=
  match ITrie.step k.k0 (ITrie.step k.k1 (ITrie.step k.k2 (ITrie.step k.k3 (ITrie.step k.k4 (ITrie.step k.k5 (ITrie.step k.k6 (ITrie.step k.k7 (ITrie.step k.k8 (ITrie.step k.k9 t))))))))) with
  | .leaf v => some v | _ => none
def ITrie.all {α : Type} (p : α → Bool) : ITrie α → Bool | .empty => true | .leaf v => p v | .branch l r => l.all p && r.all p
def ITrie.zipAll {α β : Type} (p : α → β → Bool) : ITrie α → ITrie β → Bool
  | .empty, .empty => true
  | .leaf a, .leaf b => p a b
  | .branch al ar, .branch bl br => ITrie.zipAll p al bl && ITrie.zipAll p ar br
  | _, _ => false

inductive Trie15 (α : Type) where | empty | leaf : α → Trie15 α | branch : Trie15 α → Trie15 α → Trie15 α
@[inline] def Trie15.step {α : Type} (b : Bool) : Trie15 α → Trie15 α | .branch l r => if b then r else l | _ => .empty
def Trie15.lookup {α : Type} : B16 → Trie15 α → Option α
  | ⟨b0,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15⟩, t =>
    if b0 then none else
    match Trie15.step b15 (Trie15.step b14 (Trie15.step b13 (Trie15.step b12 (Trie15.step b11 (Trie15.step b10 (Trie15.step b9 (Trie15.step b8 (Trie15.step b7 (Trie15.step b6 (Trie15.step b5 (Trie15.step b4 (Trie15.step b3 (Trie15.step b2 (Trie15.step b1 t)))))))))))))) with
    | .leaf v => some v | _ => none
def Trie15.all {α : Type} (p : α → Bool) : Trie15 α → Bool | .empty => true | .leaf v => p v | .branch l r => l.all p && r.all p
def Trie15.zipAll {α β : Type} (p : α → β → Bool) : Trie15 α → Trie15 β → Bool
  | .empty, .empty => true
  | .leaf a, .leaf b => p a b
  | .branch al ar, .branch bl br => Trie15.zipAll p al bl && Trie15.zipAll p ar br
  | _, _ => false
def inOrbitTrie (t : Trie15 (B16 × B4Code)) (f : B16) : Bool :=
  match t.lookup f with | some (g, _) => g == f | none => false

