/-- Any three 4-input linear threshold functions cannot determine `parity4`. -/
theorem parity4_not_three_ltf_determined :
    ¬ ∃ (w₁ w₂ w₃ : Nat → Int) (t₁ t₂ t₃ : Int) (Ψ : Bool → Bool → Bool → Bool),
      ∀ x : Nat → Int, (∀ j, j < 4 → x j = 0 ∨ x j = 1) →
        Ψ (decide (t₁ ≤ dot 4 w₁ x)) (decide (t₂ ≤ dot 4 w₂ x)) (decide (t₃ ≤ dot 4 w₃ x)) = parity4 x := by
  intro ⟨w1, w2, w3, t1, t2, t3, Ψ, hdetx⟩
  have hg1 : IsLtfB16 (ltfB16 w1 t1) := ⟨w1, t1, rfl⟩
  have hg2 : IsLtfB16 (ltfB16 w2 t2) := ⟨w2, t2, rfl⟩
  have hg3 : IsLtfB16 (ltfB16 w3 t3) := ⟨w3, t3, rfl⟩
  have hdet0 : ∀ p : Pt4, Ψ ((ltfB16 w1 t1).atPt p) ((ltfB16 w2 t2).atPt p) ((ltfB16 w3 t3).atPt p) = p4B16.atPt p := by
    intro p
    have hx := hdetx (pt4ToFn p) (pt4ToFn_bool p)
    rw [ltfB16_atPt, ltfB16_atPt, ltfB16_atPt, ltf4, ltf4, ltf4, p4B16_atPt_eq_parity4]
    exact hx
  rcases det_canon_12 hdet0 with ⟨Ψ1, hdet1⟩
  have h1 : isClassifiedCanon (ltfB16 w1 t1).canon = true := ltf_classified hg1
  have h2 : isClassifiedCanon (ltfB16 w2 t2).canon = true := ltf_classified hg2
