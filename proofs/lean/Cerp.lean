/-
  CERP Spike 06 — the kernel's judgments, restated and PROVED in Lean 4 (core only).

  Part A. Exhaustive equivalence for the F0 expression language:
          `decideEquiv` / `decideTask` are sound AND complete w.r.t. the
          semantics `eval` over ALL assignments σ : Nat → Bool.
  Part B. A RUP certificate checker for CNF: if `checkAll` accepts a
          certificate, the formula has no satisfying assignment.

  Nothing here is assumed: no `sorry`, no `native_decide`. Concrete
  instances (generated by cerp/lean_bridge.py) are checked by `decide`,
  i.e. by the Lean kernel itself.
-/

namespace Cerp

/-! ## Part A: expressions -/

inductive Expr where
  | const : Bool → Expr
  | var : Nat → Expr
  | not : Expr → Expr
  | and : Expr → Expr → Expr
  | or : Expr → Expr → Expr
  | xor : Expr → Expr → Expr
  | ite : Expr → Expr → Expr → Expr
  deriving Repr, DecidableEq

def eval (σ : Nat → Bool) : Expr → Bool
  | .const b => b
  | .var i => σ i
  | .not a => !(eval σ a)
  | .and a b => eval σ a && eval σ b
  | .or a b => eval σ a || eval σ b
  | .xor a b => xor (eval σ a) (eval σ b)
  | .ite c t e => if eval σ c then eval σ t else eval σ e

/-- every variable index is below `n` -/
def Scoped (n : Nat) : Expr → Bool
  | .const _ => true
  | .var i => decide (i < n)
  | .not a => Scoped n a
  | .and a b => Scoped n a && Scoped n b
  | .or a b => Scoped n a && Scoped n b
  | .xor a b => Scoped n a && Scoped n b
  | .ite c t e => Scoped n c && Scoped n t && Scoped n e

theorem eval_congr (n : Nat) (σ τ : Nat → Bool) (h : ∀ i, i < n → σ i = τ i) :
    ∀ e, Scoped n e = true → eval σ e = eval τ e := by
  intro e
  induction e with
  | const b => intro _; rfl
  | var i => intro hs; simp [Scoped] at hs; simp [eval, h i hs]
  | not a ih => intro hs; simp [Scoped] at hs; simp [eval, ih hs]
  | and a b iha ihb =>
      intro hs; simp [Scoped] at hs; simp [eval, iha hs.1, ihb hs.2]
  | or a b iha ihb =>
      intro hs; simp [Scoped] at hs; simp [eval, iha hs.1, ihb hs.2]
  | xor a b iha ihb =>
      intro hs; simp [Scoped] at hs; simp [eval, iha hs.1, ihb hs.2]
  | ite c t e ihc iht ihe =>
      intro hs; simp [Scoped] at hs
      simp [eval, ihc hs.1.1, iht hs.1.2, ihe hs.2]

/-- point update -/
def upd (ρ : Nat → Bool) (n : Nat) (b : Bool) : Nat → Bool :=
  fun i => if i = n then b else ρ i

/-- 2^n representative assignments: every pattern on variables 0..n-1 -/
def allEnvs : Nat → List (Nat → Bool)
  | 0 => [fun _ => false]
  | n + 1 => (allEnvs n).map (fun ρ => upd ρ n false) ++ (allEnvs n).map (fun ρ => upd ρ n true)

theorem allEnvs_complete (σ : Nat → Bool) :
    ∀ n, ∃ ρ, ρ ∈ allEnvs n ∧ ∀ i, i < n → ρ i = σ i := by
  intro n
  induction n with
  | zero => exact ⟨fun _ => false, by simp [allEnvs], fun i hi => absurd hi (Nat.not_lt_zero i)⟩
  | succ n ih =>
      obtain ⟨ρ, hmem, hagree⟩ := ih
      refine ⟨upd ρ n (σ n), ?_, ?_⟩
      · cases σ n
        · simp [allEnvs]; exact Or.inl ⟨ρ, hmem, rfl⟩
        · simp [allEnvs]; exact Or.inr ⟨ρ, hmem, rfl⟩
      · intro i hi
        unfold upd
        by_cases hin : i = n
        · simp [hin]
        · simp [hin]; exact hagree i (by omega)

def decideEquiv (n : Nat) (e₁ e₂ : Expr) : Bool :=
  (allEnvs n).all (fun ρ => eval ρ e₁ == eval ρ e₂)

/-- Spike 01's exhaustive kernel, sound and complete (in fragment F0). -/
theorem decideEquiv_correct (n : Nat) (e₁ e₂ : Expr)
    (h₁ : Scoped n e₁ = true) (h₂ : Scoped n e₂ = true) :
    decideEquiv n e₁ e₂ = true ↔ ∀ σ, eval σ e₁ = eval σ e₂ := by
  constructor
  · intro hd σ
    obtain ⟨ρ, hmem, hagree⟩ := allEnvs_complete σ n
    have hρ := List.all_eq_true.mp hd ρ hmem
    simp at hρ
    rw [eval_congr n σ ρ (fun i hi => (hagree i hi).symm) e₁ h₁,
        eval_congr n σ ρ (fun i hi => (hagree i hi).symm) e₂ h₂]
    exact hρ
  · intro hall
    apply List.all_eq_true.mpr
    intro ρ _
    simp [hall ρ]

def decideTask (n : Nat) (care e₁ e₂ : Expr) : Bool :=
  (allEnvs n).all (fun ρ => !eval ρ care || eval ρ e₁ == eval ρ e₂)

/-- Task-relative equivalence (agreement on the care set), sound and complete. -/
theorem decideTask_correct (n : Nat) (care e₁ e₂ : Expr)
    (hc : Scoped n care = true) (h₁ : Scoped n e₁ = true) (h₂ : Scoped n e₂ = true) :
    decideTask n care e₁ e₂ = true ↔ ∀ σ, eval σ care = true → eval σ e₁ = eval σ e₂ := by
  constructor
  · intro hd σ hcare
    obtain ⟨ρ, hmem, hagree⟩ := allEnvs_complete σ n
    have hag : ∀ i, i < n → σ i = ρ i := fun i hi => (hagree i hi).symm
    have hρ := List.all_eq_true.mp hd ρ hmem
    rw [eval_congr n σ ρ hag care hc] at hcare
    rw [eval_congr n σ ρ hag e₁ h₁, eval_congr n σ ρ hag e₂ h₂]
    simp [hcare] at hρ
    exact hρ
  · intro hall
    apply List.all_eq_true.mpr
    intro ρ _
    cases hcr : eval ρ care
    · simp
    · simp [hall ρ hcr]

/-! ## Part B: RUP certificates -/

abbrev Clause := List Int
abbrev CNF := List Clause

def litTrue (σ : Nat → Bool) (l : Int) : Bool :=
  if 0 < l then σ l.natAbs else !σ l.natAbs

def clauseSat (σ : Nat → Bool) (c : Clause) : Bool := c.any (litTrue σ)
def cnfSat (σ : Nat → Bool) (F : CNF) : Bool := F.all (clauseSat σ)

theorem litTrue_neg (σ : Nat → Bool) (l : Int) (h : l ≠ 0) :
    litTrue σ (-l) = !litTrue σ l := by
  unfold litTrue
  rw [Int.natAbs_neg]
  by_cases hp : 0 < l
  · have : ¬ (0 < -l) := by omega
    simp [hp, this]
  · have : 0 < -l := by omega
    simp [hp, this]

/-- boolean membership with its own (trivial) correctness lemma -/
def memB (x : Int) : List Int → Bool
  | [] => false
  | y :: ys => x == y || memB x ys

theorem memB_sound {x : Int} : ∀ {l : List Int}, memB x l = true → x ∈ l := by
  intro l
  induction l with
  | nil => simp [memB]
  | cons y ys ih =>
      intro h
      simp [memB] at h
      cases h with
      | inl h => simp [h]
      | inr h => exact List.mem_cons_of_mem y (ih h)

/-- a literal not falsified by the trail -/
def notFalse (trail : List Int) (l : Int) : Bool := !memB (-l) trail

def unitOf (trail : List Int) (c : Clause) : Option Int :=
  if c.any (fun l => memB l trail) then none
  else match c.filter (notFalse trail) with
    | [u] => some u
    | _ => none

def findUnit (trail : List Int) : CNF → Option Int
  | [] => none
  | c :: F => match unitOf trail c with
    | some u => some u
    | none => findUnit trail F

def conflict (trail : List Int) (F : CNF) : Bool :=
  F.any (fun c => (c.filter (notFalse trail)).isEmpty)

def propagate (F : CNF) : Nat → List Int → Bool
  | 0, _ => false
  | fuel + 1, trail =>
      if conflict trail F then true
      else match findUnit trail F with
        | some u => propagate F fuel (u :: trail)
        | none => false

def wellFormed (F : CNF) : Bool := F.all (fun c => c.all (fun l => l != 0))

/-- invariant: every trail literal is true under σ -/
def Consistent (σ : Nat → Bool) (trail : List Int) : Prop := ∀ l, l ∈ trail → litTrue σ l = true

theorem false_of_notFalse_false {σ : Nat → Bool} {trail : List Int} {l : Int}
    (hc : Consistent σ trail) (hl : l ≠ 0) (h : notFalse trail l = false) : litTrue σ l = false := by
  simp [notFalse] at h
  have hn := hc (-l) (memB_sound h)
  rw [litTrue_neg σ l hl] at hn
  simpa using hn

theorem filter_nil_all {p : Int → Bool} {c : List Int} (h : c.filter p = []) :
    ∀ l, l ∈ c → p l = false := by
  intro l hl
  cases hp : p l
  · rfl
  · have hm : l ∈ c.filter p := List.mem_filter.mpr ⟨hl, hp⟩
    rw [h] at hm
    simp at hm

theorem mem_filter_of {p : Int → Bool} {c : List Int} {l : Int} (hm : l ∈ c) (hp : p l = true) :
    l ∈ c.filter p := List.mem_filter.mpr ⟨hm, hp⟩

theorem unitOf_spec {trail : List Int} {c : Clause} {u : Int} (h : unitOf trail c = some u) :
    c.filter (notFalse trail) = [u] := by
  unfold unitOf at h
  split at h
  · simp at h
  · split at h
    · rename_i u' hu; simp at h; rw [← h]; exact hu
    · simp at h

theorem findUnit_spec {trail : List Int} {u : Int} :
    ∀ {F : CNF}, findUnit trail F = some u → ∃ c, c ∈ F ∧ c.filter (notFalse trail) = [u] := by
  intro F
  induction F with
  | nil => simp [findUnit]
  | cons c F ih =>
      intro h
      unfold findUnit at h
      split at h
      · rename_i u' hu
        simp at h; subst h
        exact ⟨c, List.mem_cons_self c F, unitOf_spec hu⟩
      · obtain ⟨d, hd, hf⟩ := ih h
        exact ⟨d, List.mem_cons_of_mem c hd, hf⟩

theorem clause_nonzero {F : CNF} (hw : wellFormed F = true) {c : Clause} (hc : c ∈ F) :
    ∀ l, l ∈ c → l ≠ 0 := by
  intro l hl
  have := List.all_eq_true.mp (List.all_eq_true.mp hw c hc) l hl
  simpa using this

/-- Unit propagation never derives a conflict from a consistent, satisfying state. -/
theorem propagate_sound (σ : Nat → Bool) (F : CNF) (hw : wellFormed F = true)
    (hsat : cnfSat σ F = true) :
    ∀ fuel trail, Consistent σ trail → propagate F fuel trail = true → False := by
  intro fuel
  induction fuel with
  | zero => intro trail _ h; simp [propagate] at h
  | succ fuel ih =>
      intro trail hc h
      unfold propagate at h
      by_cases hconf : conflict trail F = true
      · -- some clause has every literal falsified, but σ satisfies it
        unfold conflict at hconf
        obtain ⟨c, hcF, hempty⟩ := List.any_eq_true.mp hconf
        have hnil : c.filter (notFalse trail) = [] := by simpa using hempty
        have hsatc : clauseSat σ c = true := List.all_eq_true.mp hsat c hcF
        obtain ⟨l, hl, hlt⟩ := List.any_eq_true.mp hsatc
        have := false_of_notFalse_false hc (clause_nonzero hw hcF l hl) (filter_nil_all hnil l hl)
        rw [this] at hlt; exact Bool.false_ne_true hlt
      · simp [hconf] at h
        split at h
        · rename_i u hu
          obtain ⟨c, hcF, hfu⟩ := findUnit_spec hu
          -- σ satisfies c; every literal other than u is false under the trail, hence under σ
          have hsatc : clauseSat σ c = true := List.all_eq_true.mp hsat c hcF
          obtain ⟨l, hl, hlt⟩ := List.any_eq_true.mp hsatc
          have hu_true : litTrue σ u = true := by
            by_cases hnf : notFalse trail l = true
            · have hmem : l ∈ c.filter (notFalse trail) := mem_filter_of hl hnf
              rw [hfu] at hmem
              simp at hmem; rw [← hmem]; exact hlt
            · have hnf' : notFalse trail l = false := by simpa using hnf
              have := false_of_notFalse_false hc (clause_nonzero hw hcF l hl) hnf'
              rw [this] at hlt; exact absurd hlt Bool.false_ne_true
          apply ih (u :: trail) _ h
          intro l' hl'
          cases List.mem_cons.mp hl' with
          | inl e => rw [e]; exact hu_true
          | inr m => exact hc l' m
        · simp at h

def fuelFor (F : CNF) (C : Clause) : Nat := (F.map List.length).foldl (· + ·) 0 + C.length + 1

/-- RUP check of one lemma: assuming its negation, propagation reaches a conflict. -/
def rup (F : CNF) (C : Clause) : Bool := propagate F (fuelFor F C) (C.map (fun l => -l))

theorem rup_sound (σ : Nat → Bool) (F : CNF) (C : Clause) (hw : wellFormed F = true)
    (hC : ∀ l, l ∈ C → l ≠ 0) (hsat : cnfSat σ F = true) (hr : rup F C = true) :
    clauseSat σ C = true := by
  cases hcs : clauseSat σ C
  · exfalso
    apply propagate_sound σ F hw hsat (fuelFor F C) (C.map (fun l => -l)) _ hr
    intro l hl
    obtain ⟨k, hk, hkl⟩ := List.mem_map.mp hl
    rw [← hkl, litTrue_neg σ k (hC k hk)]
    have : litTrue σ k = false := by
      cases hv : litTrue σ k
      · rfl
      · have : clauseSat σ C = true := List.any_eq_true.mpr ⟨k, hk, hv⟩
        rw [hcs] at this; exact absurd this Bool.false_ne_true
    simp [this]
  · rfl

/-- Accept a certificate: every lemma is RUP w.r.t. formula + earlier lemmas,
    and the certificate ends in (contains) the empty clause. -/
def checkAll (F : CNF) : List Clause → Bool
  | [] => false
  | C :: Ls => C.all (fun l => l != 0) && rup F C && (C.isEmpty || checkAll (C :: F) Ls)

/-- If the checker accepts, NO assignment satisfies the formula. -/
theorem checkAll_sound : ∀ (Ls : List Clause) (F : CNF), wellFormed F = true →
    checkAll F Ls = true → ∀ σ, cnfSat σ F = false := by
  intro Ls
  induction Ls with
  | nil => intro F _ h; simp [checkAll] at h
  | cons C Ls ih =>
      intro F hw h σ
      simp only [checkAll, Bool.and_eq_true, Bool.or_eq_true] at h
      obtain ⟨⟨hnz, hr⟩, hrest⟩ := h
      have hC : ∀ l, l ∈ C → l ≠ 0 := by
        intro l hl; have := List.all_eq_true.mp hnz l hl; simpa using this
      cases hs : cnfSat σ F
      · rfl
      · exfalso
        have hCsat := rup_sound σ F C hw hC hs hr
        cases hrest with
        | inl hempty =>
            have : C = [] := by simpa using hempty
            subst this; simp [clauseSat] at hCsat
        | inr hnext =>
            have hw' : wellFormed (C :: F) = true := by
              simp [wellFormed] at hw ⊢; exact ⟨fun l hl => by simpa using hC l hl, hw⟩
            have hnot := ih (C :: F) hw' hnext σ
            have hyes : cnfSat σ (C :: F) = true := by
              simp only [cnfSat, List.all_cons, Bool.and_eq_true]
              exact ⟨hCsat, hs⟩
            rw [hnot] at hyes
            exact Bool.false_ne_true hyes

/-- The theorem a certificate buys: the miter is unsatisfiable. -/
theorem unsat_of_certificate (F : CNF) (Ls : List Clause)
    (hw : wellFormed F = true) (hc : checkAll F Ls = true) : ∀ σ, cnfSat σ F = false :=
  checkAll_sound Ls F hw hc

/-! ## Rendering, for the round-trip faithfulness check of the bridge -/

def Expr.render : Expr → String
  | .const b => s!"[\"const\", {if b then 1 else 0}]"
  | .var i => s!"[\"var\", {i}]"
  | .not a => s!"[\"not\", {a.render}]"
  | .and a b => s!"[\"and\", {a.render}, {b.render}]"
  | .or a b => s!"[\"or\", {a.render}, {b.render}]"
  | .xor a b => s!"[\"xor\", {a.render}, {b.render}]"
  | .ite c t e => s!"[\"ite\", {c.render}, {t.render}, {e.render}]"

end Cerp
