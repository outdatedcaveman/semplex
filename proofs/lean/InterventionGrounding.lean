import OperationalSemioticScaffold

/-!
# Intervention-relative grounding and identifiability

A dynamical object is identified operationally through responses to
admissible interventions. The resulting equivalence is budget-relative:
systems may be indistinguishable under current experiments and separable
under richer interventions.
-/

namespace Cerp.InterventionGrounding

open Cerp.OperationalSemioticScaffold

universe u v w x y

/-- A protocol assigns resource costs to interventions. -/
structure InterventionProtocol
    (S : OperationalScaffold.{u,v,w,x,y}) where
  actionCost : S.Action -> Nat

def experimentCost {S : OperationalScaffold.{u,v,w,x,y}}
    (P : InterventionProtocol S) : List S.Action -> Nat
  | [] => 0
  | a :: rest => P.actionCost a + experimentCost P rest

abbrev AffordableExperiment
    {S : OperationalScaffold.{u,v,w,x,y}}
    (P : InterventionProtocol S) (budget : Nat) :=
  {actions : List S.Action // experimentCost P actions <= budget}

/-- The observation trace generated by an externally specified intervention
    sequence, including the final post-intervention observation. -/
def experimentTrace (S : OperationalScaffold.{u,v,w,x,y}) :
    List S.Action -> S.World -> List S.Sign
  | [], world => [S.sense world]
  | action :: rest, world =>
      S.sense world :: experimentTrace S rest (S.evolve world action)

/-- Worlds are equivalent at budget B if no affordable intervention
    sequence can distinguish their observation traces. -/
def experimentEquivalent
    {S : OperationalScaffold.{u,v,w,x,y}}
    (P : InterventionProtocol S) (budget : Nat)
    (w1 w2 : S.World) : Prop :=
  forall actions, experimentCost P actions <= budget ->
    experimentTrace S actions w1 = experimentTrace S actions w2

theorem experimentEquivalent_refl
    {S : OperationalScaffold.{u,v,w,x,y}}
    (P : InterventionProtocol S) (budget : Nat) :
    forall w, experimentEquivalent P budget w w := by
  intro w actions _hcost
  rfl

theorem experimentEquivalent_symm
    {S : OperationalScaffold.{u,v,w,x,y}}
    (P : InterventionProtocol S) (budget : Nat)
    {w1 w2 : S.World}
    (h : experimentEquivalent P budget w1 w2) :
    experimentEquivalent P budget w2 w1 := by
  intro actions hcost
  exact (h actions hcost).symm

theorem experimentEquivalent_trans
    {S : OperationalScaffold.{u,v,w,x,y}}
    (P : InterventionProtocol S) (budget : Nat)
    {w1 w2 w3 : S.World}
    (h12 : experimentEquivalent P budget w1 w2)
    (h23 : experimentEquivalent P budget w2 w3) :
    experimentEquivalent P budget w1 w3 := by
  intro actions hcost
  exact (h12 actions hcost).trans (h23 actions hcost)

theorem experimentEquivalent_antitone
    {S : OperationalScaffold.{u,v,w,x,y}}
    (P : InterventionProtocol S) {b1 b2 : Nat}
    (hle : b1 <= b2) {w1 w2 : S.World}
    (h : experimentEquivalent P b2 w1 w2) :
    experimentEquivalent P b1 w1 w2 := by
  intro actions hcost
  exact h actions (Nat.le_trans hcost hle)

/-- A protocol is separating at budget B if its experiments distinguish
    every pair of distinct world states. -/
def SeparatingAt
    {S : OperationalScaffold.{u,v,w,x,y}}
    (P : InterventionProtocol S) (budget : Nat) : Prop :=
  forall w1 w2, experimentEquivalent P budget w1 w2 -> w1 = w2

/-- A two-state world whose hidden bit is not initially observable. -/
def hiddenWorldScaffold : OperationalScaffold where
  World := Bool × Bool
  Internal := Unit
  Sign := Bool
  Interpretant := Unit
  Action := Unit
  sense := fun world => world.2
  interpret := fun _ _ => ()
  chooseAction := fun _ _ => ()
  learn := fun _ _ => ()
  evolve := fun world _ => (world.1, world.1)

def revealProtocol : InterventionProtocol hiddenWorldScaffold where
  actionCost := fun _ => 1

/-- With no intervention budget, worlds with different hidden bits but
    the same current sensor output are observationally indistinguishable. -/
theorem hidden_worlds_indistinguishable_at_zero :
    experimentEquivalent revealProtocol 0 (false, false) (true, false) := by
  intro actions hcost
  cases actions with
  | nil =>
      simp [experimentTrace, hiddenWorldScaffold]
  | cons a rest =>
      simp [experimentCost, revealProtocol, Nat.succ_add] at hcost

/-- A single reveal intervention separates those same worlds. -/
theorem reveal_intervention_separates :
    ¬ experimentEquivalent revealProtocol 1
      (false, false) (true, false) := by
  intro h
  have heq := h [()] (by decide)
  change [false, false] = [false, true] at heq
  cases heq

/-- The reveal protocol identifies every world state once one intervention
    is affordable: the initial observation reveals the visible bit and the
    intervention exposes the hidden bit. -/
theorem revealProtocol_separating_at_one :
    SeparatingAt revealProtocol 1 := by
  intro w1 w2 h
  rcases w1 with ⟨hidden1, visible1⟩
  rcases w2 with ⟨hidden2, visible2⟩
  have hNow := h [] (by decide)
  have hReveal := h [()] (by decide)
  simp [experimentTrace, hiddenWorldScaffold] at hNow hReveal
  rcases hReveal with ⟨hvis, hhidden⟩
  cases hvis
  cases hhidden
  rfl

/-- At budget zero, the protocol is not separating: two distinct hidden
    states share the same empty-intervention observation. -/
theorem revealProtocol_not_separating_at_zero :
    ¬ SeparatingAt revealProtocol 0 := by
  intro h
  have heq := h (false, false) (true, false)
    (hidden_worlds_indistinguishable_at_zero)
  cases heq

end Cerp.InterventionGrounding

